{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc \"rg -n 'disclosure|renderAll|render\\\\(|fetch|addEventListener|const state|checks' game-track/web/dashboard/dashboard.js\"","aggregated_output":"12: *   checks:          [{code, gate, outcome: \"pass\"|\"fail\"}...]  in execution order\n16: *   skipped:         [{code, gate}...]   in-scope checks never reached after the hold\n70:  const state = {\n78:    // Per-family evidence counters fed only by traces: checks the engine evaluated\n105:    disclosureEvents: [],\n271:  // graph stays readable across a long session. Family weight = checks the\n322:    \"checks that ran and passed, the check that failed, checks skipped after the first failure, and families out of scope for this\",\n335:    const checks = (Array.isArray(raw.checks) ? raw.checks : []).map((c) => ({\n339:    const states = {};\n348:    for (const check of checks) {\n356:      checks,\n367:    return `${t.counts.passed} passed, ${t.counts.failed} failed, ${t.counts.skipped} skipped (checks), ${t.counts.not_evaluated} not evaluated (families)`;\n392:    for (const check of trace.checks) {\n430:      passed: trace.checks.filter((c) => c.outcome === \"pass\").length,\n431:      failed: trace.checks.filter((c) => c.outcome === \"fail\").length,\n518:    tr.checks.forEach((c, i) => {\n523:    // disclosure pair is always evaluated together, so the check that held the\n526:      lines.push(`   == short-circuit here: remaining in-scope checks were not run ==`);\n527:      const heldIndex = tr.checks.findIndex((c) => c.code === tr.heldAt);\n528:      if (heldIndex >= 0 && heldIndex < tr.checks.length - 1) lines.push(`   (held at #${heldIndex + 1} ${tr.heldAt}; the disclosure pair is always evaluated together)`);\n531:      lines.push(`${String(tr.checks.length + i + 1).padEnd(2)} ${familyLabel(s.families).padEnd(15)} ${s.code.padEnd(25)} ->| skipped`);\n551:      return `<tr><td><span class=\"mono\">${meta.symbol}</span> ${f}</td><td class=\"bar-cell\"><div class=\"bar-fill\" style=\"width:${(100 * n) / max}%\"></div><span class=\"mono\">${n}</span></td><td class=\"num\" title=\"checks the engine evaluated at this family (from traces)\">${ev.evaluated}</td><td class=\"num\">${ev.passed}</td><td class=\"num\">${ev.failed}</td><td class=\"hint\">${codes}</td></tr>`;\n553:    table.innerHTML = `<tr><th>predicate family</th><th>holds</th><th>checks evaluated</th><th>passed</th><th>failed</th><th>engine codes seen</th></tr>${rows.join(\"\")}`;\n592:  // ------------------------------------------------------------------ public semantic disclosure lane\n607:  const PUBLIC_RELATIONS = new Set([\"captain_to_lead_disclosure\", \"unknown/restricted\"]);\n609:  const PUBLIC_STATE_EFFECTS = new Set([\"fresh_disclosure\", \"redisplay_no_mutation\", \"denied_no_mutation\"]);\n622:    const checks = raw.checks && typeof raw.checks === \"object\" ? raw.checks : {};\n627:    const evaluated = Array.isArray(checks.evaluated) ? checks.evaluated.map(mapCheck) : null;\n628:    const skipped = Array.isArray(checks.skipped) ? checks.skipped.map(mapCheck) : null;\n629:    const outOfScope = Array.isArray(checks.out_of_scope) ? checks.out_of_scope.map((value) => publicEnum(value, PUBLIC_GATE_LABELS)).slice(0, 12) : null;\n630:    const unreported = Array.isArray(checks.unreported) ? checks.unreported.map(mapCheck) : null;\n640:      checks: { evaluated, skipped, outOfScope, unreported, consistent: boolOrUnknown(checks.consistent) },\n651:      const note = document.createElement(\"p\"); note.className = `empty-note ${hasEvent ? \"unknown\" : \"waiting\"}`; note.textContent = hasEvent ? \"Semantic explanation unknown: malformed or unavailable public-safe payload.\" : \"Waiting for a disclosure outcome or replay from the game.\"; root.appendChild(note); return;\n654:    const checksKnown = [explanation.checks.evaluated, explanation.checks.skipped, explanation.checks.outOfScope, explanation.checks.unreported].every(Array.isArray) && explanation.checks.consistent === true && explanation.checks.unreported.length === 0;\n655:    const unreportedCodes = explanation.checks.unreported === null ? \"unknown\" : explanation.checks.unreported.map((check) => check.code).join(\", \") || \"none\";\n659:      [\"Actual checks\", `${checkCount(explanation.checks.evaluated)} evaluated · ${checkCount(explanation.checks.skipped)} skipped · ${checkCount(explanation.checks.unreported)} unreported`, `${checkCount(explanation.checks.outOfScope)} out of scope · consistent: ${displayValue(explanation.checks.consistent)} · unreported: ${unreportedCodes}`, checksKnown ? \"known\" : \"unknown\"],\n673:    const svg = $(\"disclosure-timeline\"), list = $(\"disclosure-events\"), clock = $(\"timeline-clock\"), status = $(\"disclosure-live-status\");\n675:    const events = [...state.disclosureEvents].sort((a, b) => (a.seq ?? Number.MAX_SAFE_INTEGER) - (b.seq ?? Number.MAX_SAFE_INTEGER) || (a.tMs ?? Number.MAX_SAFE_INTEGER) - (b.tMs ?? Number.MAX_SAFE_INTEGER));\n677:      status.textContent = \"waiting for disclosure events\"; clock.textContent = \"engine clock: waiting\";\n678:      const li = document.createElement(\"li\"); li.className = \"empty-note\"; li.textContent = \"Waiting for disclosure_outcome or disclosure_replay events.\"; list.appendChild(li); return;\n685:    status.textContent = `${events.length} disclosure signal${events.length === 1 ? \"\" : \"s\"} · ordered by engine seq/t_ms`;\n699:      const li = document.createElement(\"li\"); li.className = \"disclosure-event\"; li.dataset.outcome = event.explanation?.decision.outcome === \"denied\" ? \"denied\" : eventKnown ? \"known\" : \"unknown\";\n705:      meta.textContent = `seq ${displayValue(event.seq)} · t_ms ${displayValue(event.tMs)} · checks ${e ? `${e.checks.evaluated?.length ?? \"unknown\"} evaluated, ${e.checks.skipped?.length ?? \"unknown\"} skipped, ${e.checks.outOfScope?.length ?? \"unknown\"} out of scope, ${e.checks.unreported?.length ?? \"unknown\"} unreported` : \"unknown\"} · errors ${e ? (e.decision.resultCodes.join(\", \") || \"none reported\") : \"unknown\"} · state ${e?.effect.kind || \"unknown\"} · hash equality ${e?.effect.hashEquality || \"unknown\"}`;\n743:    const rules = reference?.disclosure_rules;\n744:    const entries = [[\"python7\", \"Original Python: seven Boolean checks\"], [\"godot6\", \"Godot: six display families\"], [\"disclosure7\", \"Disclosure: seven declaration rules\"]];\n796:    const rows = cells.slice(0, 180).map((cell, index) => { const reportStatus = cell?.checks && typeof cell.checks === \"object\" ? (cell.checks.report_status === \"reported\" ? \"reported\" : \"unreported\") : cell?.report_status === \"reported\" ? \"reported\" : \"unreported\"; const outcomeValue = typeof cell?.outcome === \"string\" ? safeToken(cell.outcome) : cell?.outcome && typeof cell.outcome === \"object\" ? Object.entries(cell.outcome).filter(([, value]) => typeof value === \"number\").map(([key, value]) => `${safeToken(key)} ${value}`).join(\" · \") || \"unknown\" : \"unknown\"; const outcome = outcomeValue; const unsafe = displayValue(cell.unsafe); const mismatch = displayValue(cell.mismatch); return `<tr><td class=\"mono\">${index + 1}</td><td>${safeToken(cell?.arm, \"unknown\")}</td><td>${safeToken(cell?.case_class, \"unknown\")}</td><td>${displayValue(cell?.n)}</td><td data-status=\"${reportStatus}\">${reportStatus}</td><td>${outcome}</td><td>${unsafe}</td><td>${mismatch}</td></tr>`; });\n881:    const checks = t.trace.checks.map((c) => `${c.code}:${c.outcome}`).join(\" > \");\n882:    return ` · trace ${checks || \"(no checks)\"}${t.trace.shortCircuit ? ` > short-circuit at ${t.trace.heldAt}` : \"\"} · ${traceSummaryText(t)}`;\n913:    const action = state.verdicts.find((item) => item.id === state.selectedVerdictId) || state.pinnedVerdict, outcome = $(\"action-outcome\"), meta = $(\"action-meta\"), next = $(\"action-next\"), traceState = $(\"action-trace-state\"), legacy = $(\"action-legacy\"), checks = $(\"action-checks\");\n914:    clearChildren(checks); next.hidden = true; legacy.hidden = true; $(\"freeze-readout\").setAttribute(\"aria-pressed\", String(state.readoutFrozen)); $(\"freeze-readout\").textContent = state.readoutFrozen ? \"Unfreeze readout\" : \"Freeze readout\"; $(\"follow-latest\").hidden = !state.readoutFrozen;\n923:      const trace = action.trace; traceState.dataset.state = \"available\"; traceState.textContent = `EvaluationTrace received · ${trace.checks.length} executed check${trace.checks.length === 1 ? \"\" : \"s\"}`;\n924:      for (const check of trace.checks) { const family = check.families.join(\" / \"); const status = check.outcome === \"pass\" ? \"pass\" : check.outcome === \"fail\" ? \"fail\" : \"missing\"; addCheckRow(checks, status, status === \"pass\" ? \"Passed\" : status === \"fail\" ? \"Failed\" : \"State missing\", check.code || \"check code not reported\", family); }\n925:      for (const skipped of trace.skipped) addCheckRow(checks, \"skipped\", \"Skipped\", skipped.code || \"check code not reported\", skipped.families.join(\" / \"));\n926:      for (const family of FAMILIES.filter((f) => trace.states[f] === \"out_of_scope\")) addCheckRow(checks, \"not-evaluated\", \"Not evaluated\", \"\", family);\n927:      for (const family of trace.missing) addCheckRow(checks, \"missing\", \"State missing\", \"family state not supplied\", family);\n928:      if (!trace.checks.length && !trace.skipped.length && !trace.missing.length && !FAMILIES.some((f) => trace.states[f] === \"out_of_scope\")) { const item=document.createElement(\"li\"); item.className=\"hint\"; item.textContent=\"Trace supplied no check entries.\"; checks.appendChild(item); }\n961:    state.lastTrace=null;state.legendRows=[];state.legacyEvents=0;state.traceErrors=0;state.pendingOperation=\"\";state.hashChain=[];state.lastSummary=null;state.lastTick=null;state.lastTickAt=null;state.events=[];state.disclosureEvents=[];state.latestExplanation=null;state.trail=[];state.player=null;state.focus=\"\";state.lastHoldGates=[];state.episodeOver=false;\n966:  $(\"freeze-readout\").addEventListener(\"click\",()=>{if(state.readoutFrozen){state.readoutFrozen=false;state.pinnedVerdict=null;const latest=state.verdicts[state.verdicts.length-1];state.selectedVerdictId=latest?latest.id:null;}else{state.readoutFrozen=true;state.pinnedVerdict=state.verdicts.find((item)=>item.id===state.selectedVerdictId)||null;}renderVerdictHistory();});\n967:  $(\"follow-latest\").addEventListener(\"click\",()=>{state.readoutFrozen=false;state.pinnedVerdict=null;const latest=state.verdicts[state.verdicts.length-1];state.selectedVerdictId=latest?latest.id:null;renderVerdictHistory();});\n968:  $(\"action-history\").addEventListener(\"click\",(event)=>{const button=event.target.closest(\"button[data-verdict-id]\");if(!button)return;const id=Number(button.dataset.verdictId),action=state.verdicts.find((item)=>item.id===id);if(!action)return;state.selectedVerdictId=id;state.pinnedVerdict=action;state.readoutFrozen=true;renderVerdictHistory();});\n1028:      case \"disclosure_outcome\":\n1029:      case \"disclosure_replay\": {\n1032:        state.disclosureEvents.push(event);\n1033:        if (state.disclosureEvents.length > 180) state.disclosureEvents.shift();\n1044:        // A dialogue choice may run a top-level validate_disclosure (the early-\n1068:  window.addEventListener(\"message\", (event) => {\n1078:  const referenceSource = fetch(\"disclosure-reference.json\").then((response) => { if (!response.ok) throw new Error(\"semantic reference unavailable\"); return response.json(); }).catch(() => fetch(\"paper-reference.json\").then((response) => { if (!response.ok) throw new Error(\"legacy reference unavailable\"); return response.json(); }));\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport json\nfor p in ['research/npc-disclosure/reveal-hint-expectations-v1.json','game-track/godot/data/sealed_lighthouse.json','game-track/web/dashboard/disclosure-reference.json']:\n d=json.load(open(p));print('\\\\nFILE',p)\n for k,v in d.items():\n  if isinstance(v,list) and len(v)>10: print(k,'count',len(v),'first',json.dumps(v[0],ensure_ascii=False))\n  else: print(k,json.dumps(v,ensure_ascii=False))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport json\nfor p in ['research/npc-disclosure/reveal-hint-expectations-v1.json','game-track/godot/data/sealed_lighthouse.json','game-track/web/dashboard/disclosure-reference.json']:\n d=json.load(open(p));print('\\\\nFILE',p)\n for k,v in d.items():\n  if isinstance(v,list) and len(v)>10: print(k,'count',len(v),'first',json.dumps(v[0],ensure_ascii=False))\n  else: print(k,json.dumps(v,ensure_ascii=False))\nPY\"","aggregated_output":"\nFILE research/npc-disclosure/reveal-hint-expectations-v1.json\npacket_id \"sl-npc-disclosure-expectations-v1\"\npacket_version \"1.0.0\"\nstatus \"FROZEN_EXPECTATIONS_NOT_RUNTIME_RESULTS\"\nfrozen_at_utc \"2026-10-23T00:45:07Z\"\nauthorship {\"role\": \"Independent Disclosure Expectation Author\", \"author_id\": \"DisclosureFreeze\", \"derivation\": \"declaration_review_without_executing_any_gate\", \"expectations_source\": \"sealed_lighthouse.json declarations plus the approved interview/Seed scope\", \"not_derived_from_gate_output\": true, \"not_human_gold\": true, \"not_access_separated_holdout\": true, \"jev_role\": \"advisory_only_no_label_or_commit_authority\", \"arms\": [\"unchecked_isolated\", \"general_rule\", \"ontology_gate\"], \"shared_cases_and_expectations\": true}\nscope {\"operation\": \"reveal_hint\", \"scenario_id\": \"sealed-lighthouse-v1\", \"scenario_resource\": \"game-track/godot/data/sealed_lighthouse.json\", \"canonical_fact_ids\": [\"dock_saved\", \"keeper_betrayal\", \"lighthouse_dark\", \"tide_marks_hint\"], \"eligible_actor_ids\": [\"captain_mira\"], \"normal_stage_values\": [0, 1, 2], \"normal_knowledge_values\": [false, true], \"normal_disclosed_values\": [false, true], \"normal_denominator_formula\": \"1 eligible actor x 4 declared fact IDs x 3 declared stage values x 2 knowledge values x 2 prior-disclosed values\", \"normal_denominator\": 48, \"boundary_and_malformed_excluded_from_normal\": true, \"closed_world_display_scope\": \"Only canonical fact IDs and the two approved templates below are in scope. No free natural-language implication, hidden fact payload, or unlisted template is asserted.\"}\nsource_hashes {\"game-track/godot/scripts/sealed_lighthouse_machine.gd\": \"48da35d485473abfa9805e0dddb80d6aa6bad5c0bd183c57541886e768f839c1\", \"game-track/godot/data/sealed_lighthouse.json\": \"f262455e57be7204f5f597736a89379f37f3f698475fa745a48be6ef2ebb28d9\", \"game-track/godot/scripts/evidence_capture_runner.gd\": \"c11bdebcc2a8b69e8d69b64958a449016038481e08be158f07b19ce01da3846e\", \"game-track/godot/scripts/game3d/game_3d.gd\": \"a17361b8f17fbfd6392ebcd754dbc89ccb1b9a57e016108a0fc667a076c6cfd0\", \".ouroboros/seeds/seed-20261023-npc-disclosure-37ffdf78a47d.yaml\": \"3e601c02f44f64c90715254a9376e7c97c638f92dd27479ecb1e3df7592b81e2\", \"llm-wiki/wiki/reports/2026-10-22-ontology-signals-interview.md\": \"6ac3c97d539f09ca148704388cdd063d7d80143e0444222712212e1f15a9133d\"}\ndeclaration_derivation {\"actor_axis\": \"The scenario declares one NPC key captain_mira; the runtime binding and approved action arguments also name captain_mira.\", \"fact_axis\": \"The four IDs are the ordered union of initial_state.facts and captain_mira.knowledge, deduplicated; keeper_betrayal remains an ID only and no secret payload is included.\", \"stage_axis\": \"The initial quest stage is 0 and the sole stage gate declares tide_marks_hint minimum_stage 2; normal strata are 0, 1, and 2. -1 and 3 are boundary-only probes.\", \"knowledge_axis\": \"Each normal case toggles whether the requested canonical ID is present in the actor knowledge declaration; this is a state fixture axis, not a claim about a new NPC.\", \"prior_disclosure_axis\": \"Each normal case toggles whether the requested canonical ID is already in actor disclosed. A true value is a redisplay request and must still recheck current policy/actor/knowledge.\", \"decision_order\": \"Evaluate policy codes first; if any policy code exists, return that set and do not evaluate actor/knowledge. Otherwise reject unknown actor, then reject missing actor knowledge. Code arrays are compared as sets semantically.\", \"allow_rule\": \"Allow iff the requested ID is not permanently forbidden, every stage gate for it is satisfied, actor is eligible, and actor knows the ID.\", \"first_disclosure_effect\": \"For an allowed request with prior_disclosed=false, disclose exactly the requested canonical fact. For tide_marks_hint only, add the declared relationship-memory entry turn-05:mira-shared-tide-marks-hint; for dock_saved and lighthouse_dark, add no relationship-memory entry because no such declaration exists. Preserve stage and increase revision once.\", \"redisplay_effect\": \"For an allowed request with prior_disclosed=true, return the same approved template but do not mutate facts, actor.disclosed, relationship_memory, revision, or canonical state hash.\", \"deny_effect\": \"For any denied request, add no requested fact or approved dialogue assertion and preserve the complete canonical state. The safe fallback template is the only denial display assertion.\"}\napproved_templates [{\"template_id\": \"mira-safe-deflection-v1\", \"kind\": \"deny_fallback\", \"source\": \"game-track/godot/data/sealed_lighthouse.json:safe_fallback\", \"text_en\": \"Mira studies the dark tower and asks you to recover the signal lens first.\", \"text_ko\": \"미라는 어두운 탑을 바라보며 먼저 신호 렌즈를 회수해 달라고 말한다.\", \"permitted_for\": \"all denied cases\"}, {\"template_id\": \"sl-rc-003-authorized-hint\", \"kind\": \"authorized_disclosure\", \"source\": \"game-track/godot/scripts/evidence_capture_runner.gd:30-40\", \"capture_id\": \"sl-rc-003-authorized-hint\", \"title\": \"AUTHORIZED HINT / COMMIT\", \"narrative\": \"The restored lens authorizes Mira's tide-marks hint.\", \"status\": \"COMMIT · REPLAY-BOUND\", \"permitted_for\": \"fresh or redisplayed tide_marks_hint when all authorization conditions pass\"}]\nrule_ids {\"DISC-001\": \"permanently_forbidden fact is always denied\", \"DISC-002\": \"stage-gated fact is denied below minimum stage\", \"DISC-003\": \"only captain_mira is an eligible actor\", \"DISC-004\": \"eligible actor must know the requested fact\", \"DISC-005\": \"fresh allowed disclosure adds the requested canonical fact and disclosed ID; tide_marks_hint additionally adds the declared relationship-memory entry; stage is preserved\", \"DISC-006\": \"allowed redisplay rechecks current authorization and has no canonical mutation\", \"DISC-007\": \"denial preserves canonical state and emits only the safe fallback template\"}\nnormal_cases count 48 first {\"case_id\": \"N-001\", \"actor_id\": \"captain_mira\", \"fact_id\": \"dock_saved\", \"stage\": 0, \"knows\": false, \"prior_disclosed\": false, \"expected\": {\"allowed\": false, \"codes\": [\"NPC_DOES_NOT_KNOW_FACT\"], \"template_id\": \"mira-safe-deflection-v1\", \"rule_ids\": [\"DISC-004\", \"DISC-007\"]}}\nboundary_cases [{\"case_id\": \"B-001\", \"kind\": \"stage_below_declared_domain\", \"actor_id\": \"captain_mira\", \"fact_id\": \"tide_marks_hint\", \"stage\": -1, \"knows\": true, \"prior_disclosed\": false, \"expected\": {\"allowed\": false, \"codes\": [\"STAGE_GATED_DISCLOSURE\"], \"template_id\": \"mira-safe-deflection-v1\", \"rule_ids\": [\"DISC-002\", \"DISC-007\"]}}, {\"case_id\": \"B-002\", \"kind\": \"stage_above_normal_domain\", \"actor_id\": \"captain_mira\", \"fact_id\": \"tide_marks_hint\", \"stage\": 3, \"knows\": true, \"prior_disclosed\": false, \"expected\": {\"allowed\": true, \"codes\": [], \"template_id\": \"sl-rc-003-authorized-hint\", \"state_effect\": \"fresh_disclosure\", \"rule_ids\": [\"DISC-005\"]}}, {\"case_id\": \"B-003\", \"kind\": \"stage_exactly_below_gate\", \"actor_id\": \"captain_mira\", \"fact_id\": \"tide_marks_hint\", \"stage\": 1, \"knows\": true, \"prior_disclosed\": false, \"expected\": {\"allowed\": false, \"codes\": [\"STAGE_GATED_DISCLOSURE\"], \"template_id\": \"mira-safe-deflection-v1\", \"rule_ids\": [\"DISC-002\", \"DISC-007\"]}}, {\"case_id\": \"B-004\", \"kind\": \"stage_exactly_at_gate\", \"actor_id\": \"captain_mira\", \"fact_id\": \"tide_marks_hint\", \"stage\": 2, \"knows\": true, \"prior_disclosed\": false, \"expected\": {\"allowed\": true, \"codes\": [], \"template_id\": \"sl-rc-003-authorized-hint\", \"state_effect\": \"fresh_disclosure\", \"rule_ids\": [\"DISC-005\"]}}]\nmalformed_cases [{\"case_id\": \"M-001\", \"kind\": \"unknown_actor\", \"actor_id\": \"harbor_ghost\", \"fact_id\": \"tide_marks_hint\", \"stage\": 2, \"knows\": true, \"prior_disclosed\": false, \"expected\": {\"allowed\": false, \"codes\": [\"UNKNOWN_ACTOR\"], \"template_id\": \"mira-safe-deflection-v1\", \"rule_ids\": [\"DISC-003\", \"DISC-007\"]}}, {\"case_id\": \"M-002\", \"kind\": \"empty_actor\", \"actor_id\": \"\", \"fact_id\": \"tide_marks_hint\", \"stage\": 2, \"knows\": true, \"prior_disclosed\": false, \"expected\": {\"allowed\": false, \"codes\": [\"UNKNOWN_ACTOR\"], \"template_id\": \"mira-safe-deflection-v1\", \"rule_ids\": [\"DISC-003\", \"DISC-007\"]}}, {\"case_id\": \"M-003\", \"kind\": \"missing_actor\", \"fact_id\": \"tide_marks_hint\", \"stage\": 2, \"knows\": true, \"prior_disclosed\": false, \"expected\": {\"allowed\": false, \"codes\": [\"UNKNOWN_ACTOR\"], \"template_id\": \"mira-safe-deflection-v1\", \"rule_ids\": [\"DISC-003\", \"DISC-007\"]}}, {\"case_id\": \"M-004\", \"kind\": \"unknown_fact\", \"actor_id\": \"captain_mira\", \"fact_id\": \"sea_glass_rumor\", \"stage\": 2, \"knows\": false, \"prior_disclosed\": false, \"expected\": {\"allowed\": false, \"codes\": [\"NPC_DOES_NOT_KNOW_FACT\"], \"template_id\": \"mira-safe-deflection-v1\", \"rule_ids\": [\"DISC-004\", \"DISC-007\"]}}, {\"case_id\": \"M-005\", \"kind\": \"empty_fact\", \"actor_id\": \"captain_mira\", \"fact_id\": \"\", \"stage\": 2, \"knows\": false, \"prior_disclosed\": false, \"expected\": {\"allowed\": false, \"codes\": [\"NPC_DOES_NOT_KNOW_FACT\"], \"template_id\": \"mira-safe-deflection-v1\", \"rule_ids\": [\"DISC-004\", \"DISC-007\"]}}, {\"case_id\": \"M-006\", \"kind\": \"missing_fact\", \"actor_id\": \"captain_mira\", \"stage\": 2, \"knows\": false, \"prior_disclosed\": false, \"expected\": {\"allowed\": false, \"codes\": [\"NPC_DOES_NOT_KNOW_FACT\"], \"template_id\": \"mira-safe-deflection-v1\", \"rule_ids\": [\"DISC-004\", \"DISC-007\"]}}, {\"case_id\": \"M-007\", \"kind\": \"unknown_actor_and_forbidden_fact\", \"actor_id\": \"harbor_ghost\", \"fact_id\": \"keeper_betrayal\", \"stage\": 2, \"knows\": false, \"prior_disclosed\": false, \"expected\": {\"allowed\": false, \"codes\": [\"FORBIDDEN_DISCLOSURE\"], \"template_id\": \"mira-safe-deflection-v1\", \"rule_ids\": [\"DISC-001\", \"DISC-007\"]}}, {\"case_id\": \"M-008\", \"kind\": \"unknown_actor_and_stage_gated_fact\", \"actor_id\": \"harbor_ghost\", \"fact_id\": \"tide_marks_hint\", \"stage\": 1, \"knows\": true, \"prior_disclosed\": false, \"expected\": {\"allowed\": false, \"codes\": [\"STAGE_GATED_DISCLOSURE\"], \"template_id\": \"mira-safe-deflection-v1\", \"rule_ids\": [\"DISC-002\", \"DISC-007\"]}}]\nrule_change_fixtures [{\"fixture_id\": \"RC-001-stage-gate-2-to-1\", \"kind\": \"isolated_policy_mutation\", \"mutation\": {\"path\": \"disclosure_policy.stage_gates[0].minimum_stage\", \"from\": 2, \"to\": 1}, \"base_policy_id\": \"sealed-lighthouse-disclosure-v1\", \"paired_case_ids\": [\"N-043\", \"N-044\"], \"expected_deltas\": [{\"case_id\": \"N-043\", \"baseline\": {\"allowed\": false, \"codes\": [\"STAGE_GATED_DISCLOSURE\"]}, \"mutated\": {\"allowed\": true, \"codes\": [], \"state_effect\": \"fresh_disclosure\", \"template_id\": \"sl-rc-003-authorized-hint\"}}, {\"case_id\": \"N-044\", \"baseline\": {\"allowed\": false, \"codes\": [\"STAGE_GATED_DISCLOSURE\"]}, \"mutated\": {\"allowed\": true, \"codes\": [], \"state_effect\": \"redisplay_no_mutation\", \"template_id\": \"sl-rc-003-authorized-hint\"}}], \"expected_general_code_edit\": \"DISC-002 minimum-stage declaration only\", \"expected_ontology_declaration_edit\": \"stage_gates[0].minimum_stage only\", \"mutation_scope\": \"fixture only; never modify the shipped scenario\"}, {\"fixture_id\": \"RC-002-forbid-tide-marks-hint\", \"kind\": \"isolated_policy_mutation\", \"mutation\": {\"path\": \"disclosure_policy.permanently_forbidden\", \"from\": [\"keeper_betrayal\"], \"to\": [\"keeper_betrayal\", \"tide_marks_hint\"]}, \"base_policy_id\": \"sealed-lighthouse-disclosure-v1\", \"paired_case_ids\": [\"N-047\", \"N-048\"], \"expected_deltas\": [{\"case_id\": \"N-047\", \"baseline\": {\"allowed\": true, \"codes\": [], \"state_effect\": \"fresh_disclosure\", \"template_id\": \"sl-rc-003-authorized-hint\"}, \"mutated\": {\"allowed\": false, \"codes\": [\"FORBIDDEN_DISCLOSURE\"], \"template_id\": \"mira-safe-deflection-v1\"}}, {\"case_id\": \"N-048\", \"baseline\": {\"allowed\": true, \"codes\": [], \"state_effect\": \"redisplay_no_mutation\", \"template_id\": \"sl-rc-003-authorized-hint\"}, \"mutated\": {\"allowed\": false, \"codes\": [\"FORBIDDEN_DISCLOSURE\"], \"template_id\": \"mira-safe-deflection-v1\"}}], \"expected_general_code_edit\": \"DISC-001 forbidden-list declaration only\", \"expected_ontology_declaration_edit\": \"permanently_forbidden list only\", \"mutation_scope\": \"fixture only; never modify the shipped scenario\"}]\nstrata_denominators {\"normal\": {\"case_count\": 48, \"formula\": \"1 x 4 x 3 x 2 x 2\", \"included_case_ids\": \"N-001..N-048\"}, \"boundary\": {\"case_count\": 4, \"formula\": \"four explicit stage boundary probes\", \"included_case_ids\": \"B-001..B-004\", \"excluded_from_normal\": true}, \"malformed\": {\"case_count\": 8, \"formula\": \"eight explicit actor/fact shape and precedence probes\", \"included_case_ids\": \"M-001..M-008\", \"excluded_from_normal\": true}, \"rule_change\": {\"fixture_count\": 2, \"paired_case_count\": 4, \"excluded_from_normal\": true}}\nintegration_contract {\"materialization\": \"Load scenario_resource, deep-copy initial_state, set quest.stage to case.stage, set captain_mira.knowledge membership for case.fact_id to case.knows, and set captain_mira.disclosed membership for case.fact_id to case.prior_disclosed. Do not execute a gate to derive expected fields.\", \"request\": \"Invoke reveal_hint with actor_id/fact_id from the case. For missing actor/fact malformed cases, omit the named key exactly as represented by the case.\", \"comparison\": \"All three arms consume the same case IDs and expected object. Compare allowed, semantic code set, template permission, and state effect. Code array ordering is non-semantic; compare as sorted unique sets.\", \"fresh_state_assertions\": [\"denied: complete canonical state unchanged\", \"allowed fresh: requested fact/disclosed ID added, tide_marks_hint adds only turn-05:mira-shared-tide-marks-hint, generic allowed facts add no memory, stage unchanged, revision +1, hash changes\", \"allowed redisplay: facts/disclosed/relationship_memory/revision/hash byte-for-byte unchanged\"], \"display_assertions\": \"Denied cases may assert only mira-safe-deflection-v1. Only tide_marks_hint allowed cases may assert sl-rc-003-authorized-hint. Generic allowed canonical facts have template_id null and must not invent dialogue text.\", \"arm_boundary\": \"unchecked_isolated may observe intentional violations; general_rule and ontology_gate are held to the frozen expectations. No arm may rewrite this packet.\", \"mutation_execution\": \"Clone only the declared policy fixture in memory or a disposable fixture file; run paired case IDs and report edit scope, missed cases, and changed expectations. Never alter game-track/godot/data/sealed_lighthouse.json.\", \"evidence\": \"Record packet path, packet sidecar SHA-256, source hashes, contract version, case ID, rule IDs, prior/next state hashes, and rendered template ID. Do not report this packet as human gold, holdout, efficacy, or player benefit evidence.\"}\nlimitations [\"This is a closed declaration-derived engineering expectation set, not all reachable game states.\", \"No free natural-language semantics, implicit inference, hidden payload, or all-channel leakage claim is made.\", \"No new NPC, story, arm, human annotation, independent semantic gold, or access-separated holdout is introduced.\", \"The shipped machine currently predates the redisplay no-mutation contract; this packet freezes the approved target behavior for implementation and evaluation.\"]\n\nFILE game-track/godot/data/sealed_lighthouse.json\nschema_version \"1.0.0\"\nscenario_id \"sealed-lighthouse-v1\"\ntitle_en \"The Sealed Lighthouse\"\ntitle_ko \"봉인된 등대\"\ninitial_state {\"state_schema_version\": \"1.0.0\", \"scenario_id\": \"sealed-lighthouse-v1\", \"revision\": 0, \"player\": {\"location\": \"harbor_dock\", \"inventory\": []}, \"world\": {\"reachable_locations\": [\"harbor_dock\", \"lamp_store\"], \"object_locations\": {\"signal_lens\": \"lamp_store\"}}, \"quest\": {\"stage\": 0, \"flags\": [\"dock_saved\"]}, \"facts\": [\"dock_saved\", \"lighthouse_dark\"], \"npcs\": {\"captain_mira\": {\"knowledge\": [\"dock_saved\", \"keeper_betrayal\", \"lighthouse_dark\", \"tide_marks_hint\"], \"disclosed\": [\"dock_saved\", \"lighthouse_dark\"], \"relationship_memory\": []}}}\ndisclosure_policy {\"policy_id\": \"sealed-lighthouse-disclosure-v1\", \"permanently_forbidden\": [\"keeper_betrayal\"], \"stage_gates\": [{\"fact_id\": \"tide_marks_hint\", \"minimum_stage\": 2}]}\nsafe_fallback {\"fallback_id\": \"mira-safe-deflection-v1\", \"text_en\": \"Mira studies the dark tower and asks you to recover the signal lens first.\", \"text_ko\": \"미라는 어두운 탑을 바라보며 먼저 신호 렌즈를 회수해 달라고 말한다.\"}\n\nFILE game-track/web/dashboard/disclosure-reference.json\ndisclosure_rules {\"boundary\": \"Python validator checks, Godot display families, and frozen disclosure rules are distinct non-isomorphic label sets.\", \"disclosure7\": [{\"id\": \"DISC-001\", \"label\": \"Permanent prohibition\"}, {\"id\": \"DISC-002\", \"label\": \"Stage-gated denial\"}, {\"id\": \"DISC-003\", \"label\": \"Eligible actor\"}, {\"id\": \"DISC-004\", \"label\": \"Actor knowledge\"}, {\"id\": \"DISC-005\", \"label\": \"Fresh authorized disclosure\"}, {\"id\": \"DISC-006\", \"label\": \"Authorized redisplay\"}, {\"id\": \"DISC-007\", \"label\": \"Denial preserves state\"}], \"godot6\": [{\"id\": \"POLICY\", \"label\": \"Policy\"}, {\"id\": \"PRECONDITION\", \"label\": \"Precondition\"}, {\"id\": \"REACHABILITY\", \"label\": \"Reachability\"}, {\"id\": \"KNOWLEDGE\", \"label\": \"Knowledge\"}, {\"id\": \"DISCLOSURE\", \"label\": \"Disclosure\"}, {\"id\": \"QUEST STAGE\", \"label\": \"Quest stage\"}], \"python7\": [{\"id\": \"action_policy\", \"label\": \"Action policy\"}, {\"id\": \"precondition\", \"label\": \"Precondition\"}, {\"id\": \"object_reachability\", \"label\": \"Object reachability\"}, {\"id\": \"npc_knowledge\", \"label\": \"NPC knowledge\"}, {\"id\": \"forbidden_disclosure\", \"label\": \"Forbidden disclosure\"}, {\"id\": \"quest_stage\", \"label\": \"Quest stage\"}, {\"id\": \"quest_stage_monotonicity\", \"label\": \"Quest-stage monotonicity\"}]}\nfrozen_comparison {\"arms\": [\"unchecked_isolated\", \"general_rule\", \"ontology_gate\"], \"case_counts\": {\"boundary\": 4, \"malformed\": 8, \"normal\": 48, \"total\": 60}, \"cells\": {\"general_rule\": {\"boundary\": {\"checks\": {\"fail\": 4, \"pass\": 2, \"report_status\": \"reported\"}, \"mismatch\": 0, \"n\": 4, \"outcome\": {\"allowed\": 2, \"denied\": 2}, \"replay\": {\"equal\": 4, \"unequal\": 0}, \"report_status\": \"reported\", \"unsafe\": 0}, \"malformed\": {\"checks\": {\"fail\": 16, \"pass\": 0, \"report_status\": \"reported\"}, \"mismatch\": 0, \"n\": 8, \"outcome\": {\"allowed\": 0, \"denied\": 8}, \"replay\": {\"equal\": 8, \"unequal\": 0}, \"report_status\": \"reported\", \"unsafe\": 0}, \"normal\": {\"checks\": {\"fail\": 68, \"pass\": 14, \"report_status\": \"reported\"}, \"mismatch\": 0, \"n\": 48, \"outcome\": {\"allowed\