','동결 기대값은 정상 48건, 경계 4건, 비정상 8건과 규칙 변경 픽스처 2건이다. 실시간 이벤트가 아니다. 근거에는 패킷·버전, 규칙, 해시, 템플릿이 연결되며 누락 필드는 통과나 전체 상태의 근거가 될 수 없다.',['strata_denominators','integration_contract.evidence'],list(packet['rule_ids']))]\nroles=[]\nfor id,en,ko,ids,content_en,content_ko,evidence,rules in rows:\n roles.append(dict(id=id,labels=dict(en=en,ko=ko),identifiers=ids,content=dict(en=content_en,ko=content_ko),evidence_refs=evidence,rule_ids=rules))\nm=dict(schema_version='ontology-evidence-map/v1',source_packet=dict(path='research/npc-disclosure/reveal-hint-expectations-v1.json',packet_id=packet['packet_id'],packet_version=packet['packet_version'],sha256='9920aa834910a3ee35ed4446de4fdba42bb67dda71b07a93bccfc7a0b2e09028',status=packet['status']),scenario=dict(path='game-track/godot/data/sealed_lighthouse.json',sha256='f262455e57be7204f5f597736a89379f37f3f698475fa745a48be6ef2ebb28d9'),rule_sets=ref['disclosure_rules'],disclosure_rule_meanings=packet['rule_ids'],roles=roles)\n(base/'ontology-map.json').write_text(json.dumps(m,ensure_ascii=False,indent=2)+'\\\\n')\np=base/'index.html';s=p.read_text();needle='      <section class=\\\"nebula card\\\"'\nsection='''      <section class=\\\"ontology-map card\\\" aria-labelledby=\\\"ontology-map-title\\\">\n        <div class=\\\"card-head\\\"><h2 id=\\\"ontology-map-title\\\">Ontology structure → evidence / <span lang=\\\"ko\\\">온톨로지 구조 → 근거</span></h2></div>\n        <p class=\\\"diagram-boundary\\\" id=\\\"ontology-map-boundary\\\">Read-only declarations and latest public disclosure event are separate. Missing/unreported evidence is never pass. Full canonical state is unavailable from this projection. / <span lang=\\\"ko\\\">읽기 전용 선언과 최신 공개 이벤트는 별개이다. 누락·미보고 근거는 통과가 아니다. 전체 정규 상태는 이 투영에서 확인할 수 없다.</span></p>\n        <p id=\\\"ontology-map-status\\\" class=\\\"hint\\\" role=\\\"status\\\" aria-live=\\\"polite\\\">Loading declarations; observed evidence missing/unreported. / <span lang=\\\"ko\\\">선언 로딩 중 · 관측 근거 누락·미보고.</span></p>\n        <p id=\\\"ontology-map-source\\\" class=\\\"hint\\\"></p>\n        <div class=\\\"tbl-wrap\\\"><table class=\\\"tbl ontology-table\\\" aria-describedby=\\\"ontology-map-boundary ontology-map-source\\\">\n          <caption>Declared structure versus observed evidence / <span lang=\\\"ko\\\">선언 구조와 관측 근거</span></caption>\n          <thead><tr><th scope=\\\"col\\\">Role / <span lang=\\\"ko\\\">역할</span></th><th scope=\\\"col\\\">Declared content and relations / <span lang=\\\"ko\\\">선언 내용·관계</span></th><th scope=\\\"col\\\">Frozen source evidence and rules / <span lang=\\\"ko\\\">동결 출처·규칙</span></th><th scope=\\\"col\\\">Latest observed disclosure event / <span lang=\\\"ko\\\">최신 관측 공개 이벤트</span></th></tr></thead>\n          <tbody id=\\\"ontology-map-rows\\\"></tbody>\n        </table></div>\n        <div id=\\\"ontology-map-rules\\\" class=\\\"ontology-rule-sets\\\" aria-label=\\\"Distinct rule sets / 구별되는 규칙 집합\\\"></div>\n      </section>\n'''\nassert needle in s;s=s.replace(needle,section+needle,1);p.write_text(s)\np=base/'dashboard.css';p.write_text(p.read_text()+'''\n/* Read-only ontology declarations remain separate from event projections. */\n.ontology-map { overflow-wrap:anywhere; }\n.ontology-table { table-layout:fixed; }\n.ontology-table caption { text-align:left; padding:8px 6px; color:var(--muted); }\n.ontology-table th, .ontology-table td { padding:8px 6px; }\n.ontology-table th:first-child { width:13%; }\n.ontology-table p { margin:0 0 6px; }\n.ontology-table code { font-size:11px; }\n.ontology-rule-sets { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:12px; }\n.ontology-rule-sets ul { padding-left:18px; font-size:12px; }\n@media (max-width:720px) {\n  .ontology-table, .ontology-table tbody, .ontology-table tr, .ontology-table td, .ontology-table th { display:block; width:100%; }\n  .ontology-table thead { position:absolute; width:1px; height:1px; overflow:hidden; clip-path:inset(50%); }\n  .ontology-table th:first-child { width:100%; color:var(--amber); }\n  .ontology-table tbody tr { margin-bottom:12px; border:1px solid var(--line); }\n  .ontology-table td::before { content:attr(data-label); display:block; color:var(--muted); font-weight:600; margin-bottom:4px; }\n  .ontology-rule-sets { grid-template-columns:minmax(0,1fr); }\n}\n''')\nPY\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('game-track/web/dashboard/dashboard.js');s=p.read_text();needle='  function displayValue(value)'\npos=s.index(needle)\ncode='''  // Local read-only map: never writes game state or the frozen comparison reference.\n  const ONTOLOGY_ROLES = [\\\"world\\\", \\\"actor\\\", \\\"knowledge\\\", \\\"fact\\\", \\\"policy\\\", \\\"quest\\\", \\\"action\\\", \\\"trace\\\"];\n  let ontologyMap = null;\n  const unavailableEvidence = \\\"unavailable · missing/unreported / 확인 불가 · 누락·미보고\\\";\n  function validOntologyMap(map) {\n    const text = (value) => typeof value === \\\"string\\\" && value.trim().length > 0 && value.length <= 4000;\n    const bilingual = (value) => value && text(value.en) && text(value.ko);\n    const strings = (value) => Array.isArray(value) && value.length <= 32 && value.every(text);\n    const sets = map?.rule_sets;\n    return map?.schema_version === \\\"ontology-evidence-map/v1\\\"\n      && map.source_packet?.sha256 === \\\"9920aa834910a3ee35ed4446de4fdba42bb67dda71b07a93bccfc7a0b2e09028\\\"\n      && map.source_packet?.packet_id === \\\"sl-npc-disclosure-expectations-v1\\\"\n      && map.source_packet?.packet_version === \\\"1.0.0\\\" && text(map.source_packet.path)\n      && Array.isArray(map.roles) && map.roles.length === ONTOLOGY_ROLES.length\n      && ONTOLOGY_ROLES.every((id) => map.roles.filter((role) => role?.id === id).length === 1)\n      && map.roles.every((role) => bilingual(role.labels) && bilingual(role.content) && text(role.identifiers)\n        && strings(role.evidence_refs) && role.evidence_refs.length > 0 && strings(role.rule_ids)\n        && role.rule_ids.every((id) => DISCLOSURE_RULE_IDS.has(id)))\n      && [[\\\"python7\\\", 7], [\\\"godot6\\\", 6], [\\\"disclosure7\\\", 7]].every(([key, count]) =>\n        Array.isArray(sets?.[key]) && sets[key].length === count\n        && new Set(sets[key].map((rule) => rule?.id)).size === count\n        && sets[key].every((rule) => text(rule?.id) && text(rule?.label)))\n      && [...DISCLOSURE_RULE_IDS].every((id) => text(map.disclosure_rule_meanings?.[id]));\n  }\n  function ontologyObserved(id) {\n    const event = state.disclosureEvents[state.disclosureEvents.length - 1];\n    const e = event?.explanation;\n    if (\"'!e) return unavailableEvidence;\n    const value = (v) => v === null || v === undefined || v === \"unknown\" || v === \"\" ? unavailableEvidence : String(v);\n    const rules = e.ontology.ruleIds.length ? e.ontology.ruleIds.join(\", \") : unavailableEvidence;\n    switch (id) {\n      case \"world\": return `Current world/location / 현재 세계·위치: ${unavailableEvidence}`;\n      case \"actor\": return `Reported actor role / 보고된 행위자 역할: ${value(e.input.actorRole)}. Actor ID / 행위자 ID: ${unavailableEvidence}`;\n      case \"knowledge\": return `Knowledge membership; disclosed set / 지식 포함 여부·공개 집합: ${unavailableEvidence}. Relation / 관계: ${value(e.ontology.relation)}`;\n      case \"fact\": return `Subject type / 대상 유형: ${value(e.input.subjectType)}. Canonical fact ID and full facts / 정규 사실 ID·전체 사실: ${unavailableEvidence}`;\n      case \"policy\": return `Reported rule IDs / 보고된 규칙 ID: ${rules}. Full current policy / 전체 현재 정책: ${unavailableEvidence}`;\n      case \"quest\": return `Current quest stage and flags / 현재 퀘스트 단계·플래그: ${unavailableEvidence}`;\n      case \"action\": return `Operation / 연산: ${value(e.input.operation)} · decision / 결정: ${value(e.decision.outcome)} · state effect / 상태 효과: ${value(e.effect.kind)} · mutated / 변경 여부: ${value(e.effect.mutated)}`;\n      case \"trace\": {\n        const checks = (items) => items === null ? unavailableEvidence : items.length ? items.map((c) => `${c.code} (${c.gate}): ${value(c.outcome)}`).join(\"; \") : \"none reported / 보고 항목 없음\";\n        return `seq: ${value(e.engine.seq)} · t_ms: ${value(e.engine.tMs)} · evaluated / 실행: ${checks(e.checks.evaluated)} · skipped / 건너뜀: ${checks(e.checks.skipped)} · unreported / 미보고: ${checks(e.checks.unreported)} · out of scope / 범위 밖: ${e.checks.outOfScope === null ? unavailableEvidence : e.checks.outOfScope.join(\", \") || \"none reported / 보고 항목 없음\"} · prior hash: ${value(e.effect.priorHash)} · next hash: ${value(e.effect.nextHash)} · template ID / 템플릿 ID: ${unavailableEvidence}`;\n      }\n      default: return unavailableEvidence;\n    }\n  }\n  function renderOntologyEvidence() {\n    const body = $(\"ontology-map-rows\");\n    if (!body || !ontologyMap) return;\n    for (const id of ONTOLOGY_ROLES) {\n      const cell = body.querySelector(`[data-observed-role=\"${id}\"]`);\n      if (cell) cell.textContent = ontologyObserved(id);\n    }\n  }\n  function renderOntologyMap(map) {\n    const body = $(\"ontology-map-rows\"), sets = $(\"ontology-map-rules\");\n    if (!body || !sets) return;\n    clearChildren(body); clearChildren(sets);\n    function paragraph(parent, text, lang) {\n      const node = document.createElement(\"p\"); node.textContent = text;\n      if (lang) node.lang = lang;\n      parent.appendChild(node);\n    }\n    for (const id of ONTOLOGY_ROLES) {\n      const role = map.roles.find((item) => item.id === id), row = document.createElement(\"tr\");\n      const heading = document.createElement(\"th\"); heading.scope = \"row\";\n      paragraph(heading, `${role.labels.en} (${role.id})`, \"en\"); paragraph(heading, role.labels.ko, \"ko\"); row.appendChild(heading);\n      const declared = document.createElement(\"td\"); declared.dataset.label = \"Declared / 선언\";\n      paragraph(declared, role.identifiers); paragraph(declared, role.content.en, \"en\"); paragraph(declared, role.content.ko, \"ko\"); row.appendChild(declared);\n      const evidence = document.createElement(\"td\"); evidence.dataset.label = \"Frozen evidence / 동결 근거\";\n      paragraph(evidence, `${map.source_packet.packet_id} · ${role.evidence_refs.join(\"; \")}`);\n      paragraph(evidence, role.rule_ids.join(\", \") || \"No disclosure rule assigned / 연결된 공개 규칙 없음\"); row.appendChild(evidence);\n      const observed = document.createElement(\"td\"); observed.dataset.label = \"Observed event / 관측 이벤트\";\n      observed.dataset.observedRole = id; row.appendChild(observed); body.appendChild(row);\n    }\n    for (const [key, title] of [[\"python7\", \"Seven Python checks / Python 검사 7개\"], [\"godot6\", \"Six Godot families / Godot 표시 계열 6개\"], [\"disclosure7\", \"Seven DISC rules / DISC 선언 규칙 7개\"]]) {\n      const section = document.createElement(\"section\"), heading = document.createElement(\"h3\"), list = document.createElement(\"ul\");\n      heading.textContent = title; section.appendChild(heading);\n      for (const rule of map.rule_sets[key]) {\n        const item = document.createElement(\"li\");\n        item.textContent = `${rule.id}: ${key === \"disclosure7\" ? map.disclosure_rule_meanings[rule.id] : rule.label}`;\n        list.appendChild(item);\n      }\n      section.appendChild(list); sets.appendChild(section);\n    }\n    $(\"ontology-map-source\").textContent = `${map.source_packet.path} · v${map.source_packet.packet_version} · SHA256 ${map.source_packet.sha256}. Expectations, not runtime results / 기대값이며 실행 결과가 아님. Python checks, Godot families and DISC rules are distinct, not one-to-one / 세 집합은 별개이며 일대일 대응이 아님.`;\n    $(\"ontology-map-status\").textContent = \"Declarations loaded · observed column follows latest public disclosure event only / 선언 로드 완료 · 관측 열은 최신 공개 이벤트만 반영\";\n    renderOntologyEvidence();\n  }\n  function loadOntologyMap() {\n    fetch(\"ontology-map.json\").then((response) => {\n      if (!response.ok) throw new Error(\"map unavailable\");\n      return response.json();\n    }).then((map) => {\n      if (!validOntologyMap(map)) throw new Error(\"malformed map\");\n      ontologyMap = map; renderOntologyMap(map);\n    }).catch(() => {\n      ontologyMap = null;\n      clearChildren($(\"ontology-map-rows\")); clearChildren($(\"ontology-map-rules\"));\n      $(\"ontology-map-source\").textContent = \"\";\n      $(\"ontology-map-status\").textContent = \"Ontology map unavailable (missing or malformed); evidence missing/unreported / 온톨로지 맵 확인 불가 (누락 또는 형식 오류) · 근거 누락·미보고\";\n    });\n  }\n'\"'''\ns=s[:pos]+code+s[pos:]\ns=s.replace('renderSemanticExplanation(null);renderDisclosureTimeline();updateLinkState();','renderSemanticExplanation(null);renderDisclosureTimeline();renderOntologyEvidence();updateLinkState();')\ns=s.replace('        renderSemanticExplanation(explanation, true);','        renderSemanticExplanation(explanation, true);\\\\n        renderOntologyEvidence();')\ns=s.replace('  const referenceSource = fetch(', '  loadOntologyMap();\\\\n  const referenceSource = fetch(',1)\np.write_text(s)\nPY\nnode --check game-track/web/dashboard/dashboard.js\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
