{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/zsh -lc 'cat game-track/web/dashboard/index.html game-track/web/dashboard/dashboard.css game-track/web/dashboard/dashboard.js'","aggregated_output":"<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>TRACE-RPG live commit-gate dashboard</title>\n  <link rel=\"stylesheet\" href=\"dashboard.css?v=20261023-signal-explainer\">\n  <link rel=\"icon\" type=\"image/png\" href=\"../public/index.icon.png\">\n</head>\n<body>\n  <header class=\"topbar\">\n    <div class=\"title\"><span class=\"brand\">TRACE-RPG</span><span class=\"sub\"><em>The Sealed Lighthouse</em> · gameplay view</span></div>\n    <div class=\"top-metrics\" aria-label=\"Live session counters\">\n      <span><b id=\"kpi-commits\">—</b><small>commits</small></span><span><b id=\"kpi-holds\" class=\"coral\">—</b><small>holds</small></span><span><b id=\"kpi-stage\">—</b><small>stage</small></span><span><b id=\"kpi-revision\">—</b><small>revision</small></span><span><b id=\"kpi-facts\">—</b><small>facts</small></span><span><b id=\"kpi-episode\">waiting</b><small>episode</small></span>\n    </div>\n    <span id=\"link-state\" class=\"pill waiting\" role=\"status\" aria-live=\"polite\">waiting for game events</span>\n  </header>\n  <main class=\"dashboard\">\n    <section class=\"game card\" aria-labelledby=\"game-title\"><div class=\"card-head\"><h1 id=\"game-title\">The Sealed Lighthouse</h1><span class=\"hint\">Click the game to play · WASD move · mouse look · E interact · 1-4 choose · T guide · C case file · H help · <a class=\"paper-link\" href=\"../public/index.html\" target=\"_blank\" rel=\"noopener\">full-screen game</a> (best for the full route on narrow screens)</span></div><div class=\"frame-wrap\"><iframe id=\"game\" src=\"../public/index.html\" title=\"The Sealed Lighthouse\" allow=\"autoplay; fullscreen\"></iframe></div></section>\n    <aside class=\"rail\" aria-label=\"Quest and recent activity\">\n      <section class=\"card quest-card\" aria-labelledby=\"quest-title\"><div class=\"card-head\"><h2 id=\"quest-title\">Quest</h2><span id=\"quest-stage-label\" class=\"hint\">waiting for session</span></div><p id=\"quest-objective\" class=\"quest-objective\">Waiting for the game session summary.</p><ol id=\"quest-steps\" class=\"quest-steps\" aria-label=\"Quest progress\"></ol><p id=\"quest-note\" class=\"quest-note\">Progress appears from committed session summaries.</p></section>\n      <section class=\"card minimap\" aria-labelledby=\"map-title\"><div class=\"card-head\"><h2 id=\"map-title\">Harbor plan</h2><span id=\"map-caption\" class=\"hint\">waiting for game session</span></div><svg id=\"minimap\" viewBox=\"0 0 320 260\" preserveAspectRatio=\"xMidYMid meet\" role=\"img\" aria-label=\"Harbor mini-map\"></svg><p id=\"map-focus\" class=\"map-focus\">Player position appears when the game sends a tick.</p></section>\n      <section class=\"card recent-card\" aria-labelledby=\"recent-title\"><div class=\"card-head\"><h2 id=\"recent-title\">Recent actions</h2><span id=\"recent-count\" class=\"hint\">0 verdicts</span></div><ol id=\"recent-actions\" class=\"recent-actions\"></ol><p id=\"recent-empty\" class=\"empty-note\">Actions will appear here after the first commit or hold.</p></section>\n    </aside>\n    <section class=\"card action-card\" aria-labelledby=\"action-title\">\n      <div class=\"card-head action-head\"><div><h2 id=\"action-title\">Last action</h2><p id=\"action-meta\" class=\"hint\">Waiting for the first verdict · the game is still live.</p></div><div class=\"readout-controls\"><button id=\"freeze-readout\" class=\"control-button\" type=\"button\" aria-pressed=\"false\">Freeze readout</button><button id=\"follow-latest\" class=\"control-button secondary\" type=\"button\" hidden>Follow latest</button></div></div>\n      <p id=\"action-outcome\" class=\"action-outcome\">No action verdict yet.</p><p id=\"action-next\" class=\"action-next\" hidden></p><div id=\"action-trace-state\" class=\"trace-state\" aria-label=\"Trace availability\">Trace: waiting for verdict</div><ol id=\"action-checks\" class=\"action-checks\" aria-label=\"Checks reported by the selected action\"></ol><p id=\"action-legacy\" class=\"legacy-note\" hidden></p>\n      <div class=\"action-history-head\"><h3>Verdict history</h3><span id=\"newer-actions\" class=\"hint\" aria-live=\"polite\">No newer actions</span></div><ol id=\"action-history\" class=\"action-history\" aria-label=\"Select a verdict to read\"></ol>\n    </section>\n    <section class=\"timeline card\" aria-labelledby=\"timeline-title\"><div class=\"card-head\"><h2 id=\"timeline-title\">Session activity overview</h2><span class=\"hint\" id=\"timeline-hint\">recent browser receipt view · use Live disclosure signals for engine order</span></div><svg id=\"timeline\" viewBox=\"0 0 1000 150\" preserveAspectRatio=\"none\" role=\"img\" aria-label=\"Recent session activity overview\"></svg></section>\n    <section class=\"card disclosure-live\" aria-labelledby=\"disclosure-live-title\"><div class=\"card-head\"><h2 id=\"disclosure-live-title\">Live disclosure signals</h2><span id=\"disclosure-live-status\" class=\"hint\" role=\"status\" aria-live=\"polite\">waiting for disclosure events</span></div><p class=\"diagram-boundary\">Content-first readout: typed input → ontology relation and rules → actual checks → decision → state transition. This panel renders only public-safe fields returned by the game.</p><div id=\"semantic-explanation\" class=\"semantic-flow\" aria-live=\"polite\"><p class=\"empty-note\">Waiting for a disclosure outcome or replay. No decision is inferred from an empty stream.</p></div><section class=\"disclosure-timeline\" aria-labelledby=\"disclosure-timeline-title\"><div class=\"card-head\"><h3 id=\"disclosure-timeline-title\">Within-session ordered timeline</h3><span id=\"timeline-clock\" class=\"hint\">engine clock: waiting</span></div><svg id=\"disclosure-timeline\" viewBox=\"0 0 1000 180\" preserveAspectRatio=\"none\" role=\"img\" aria-label=\"Ordered disclosure signal timeline\"></svg><ol id=\"disclosure-events\" class=\"disclosure-events\" aria-label=\"Ordered disclosure signal events\"><li class=\"empty-note\">Waiting for disclosure_outcome or disclosure_replay events.</li></ol></section></section>\n    <section class=\"card frozen-comparison\" aria-labelledby=\"comparison-title\"><div class=\"card-head\"><h2 id=\"comparison-title\">Frozen independent comparison</h2><span id=\"comparison-status\" class=\"hint\">waiting for disclosure-reference.json</span></div><p class=\"diagram-boundary\">This lane loads only the trusted local frozen comparison contract; it is not a live trend or game result.</p><p id=\"comparison-claim-boundary\" class=\"comparison-note\">Waiting for the bounded checker claim boundary. No comparison claim is inferred before validation.</p><div class=\"comparison-grid\"><div><svg id=\"comparison-graph\" viewBox=\"0 0 640 260\" preserveAspectRatio=\"xMidYMid meet\" role=\"img\" aria-label=\"Frozen comparison counts by arm\"></svg><div class=\"comparison-legend\" id=\"comparison-legend\" aria-label=\"Frozen comparison legend\"></div></div><div class=\"tbl-wrap\"><table id=\"comparison-matrix\" class=\"tbl\" aria-label=\"Frozen comparison cell status matrix\"></table></div></div><div id=\"rule-boundaries\" class=\"rule-boundaries\" aria-label=\"Disclosure rule boundaries\"></div></section>\n    <details class=\"engineering card\"><summary>Engineering detail <span class=\"hint\">reviewer view · not needed to play</span><span class=\"pill boundary\">engineering demonstration · not evidence</span></summary><div class=\"engineering-content\">\n      <div class=\"engineering-status\"><span id=\"session-hash\" class=\"mono\" title=\"SHA-256 of the committed canonical snapshot\">state —</span><a class=\"paper-link\" href=\"/paper/en.pdf\" download>English paper</a><a class=\"paper-link\" href=\"/paper/ko.pdf\" download>한국어 논문</a></div>\n      <section class=\"nebula card\" aria-labelledby=\"trace-title\"><div class=\"card-head\"><h2 id=\"trace-title\">Commit gate - live per-node evaluation trace</h2><span class=\"hint\">pass / fail / skipped / not evaluated are distinct; missing stays missing</span></div><p class=\"diagram-boundary\">Pulses show only checks the engine executed for that proposal, in execution order, from the returned trace. A hold marks in-scope checks not reached as skipped; out-of-scope families are not evaluated, not passed. Family weight counts checks evaluated there. This is engineering demonstration, not efficacy or usability evidence.</p><svg id=\"nebula\" viewBox=\"0 0 640 440\" preserveAspectRatio=\"xMidYMid meet\" role=\"img\" aria-label=\"Per-proposal commit-gate evaluation trace\"></svg><div class=\"legend\"><ul id=\"legend-rows\" class=\"legend-rows\"></ul><div id=\"legend-counts\" class=\"legend-counts mono\"></div></div><h3>Last proposal trace <span class=\"hint\">execution order · engine short-circuit rule</span></h3><pre id=\"last-trace\" class=\"last-trace mono\"></pre></section>\n      <section class=\"metrics card\" aria-labelledby=\"metrics-title\"><div class=\"card-head\"><h2 id=\"metrics-title\">Session and paper counts</h2><span class=\"hint\">engine-reported summary and frozen reference values</span></div><h3>Holds by predicate family <span class=\"hint\">paper Table II · engine codes</span></h3><div class=\"tbl-wrap\"><table id=\"gate-table\" class=\"tbl\"></table></div><h3>Trace hash chain <span class=\"hint\">holds leave the committed snapshot unchanged</span></h3><ol id=\"hash-chain\" class=\"chain mono\"></ol><h3>Session vs frozen paper counts</h3><div class=\"tbl-wrap\"><table id=\"ref-table\" class=\"tbl\"></table></div></section>\n      <section class=\"log card\" aria-labelledby=\"raw-log-title\"><div class=\"card-head\"><h2 id=\"raw-log-title\">Raw event feed</h2><span class=\"hint mono\" id=\"log-count\">0 events</span></div><pre id=\"log\" class=\"mono\"></pre></section>\n    </div></details>\n  </main>\n  <footer class=\"bar foot\"><span>Data path: Godot presentation layer → <code>window.parent.postMessage</code> → this page. The dashboard renders returned game events; it cannot propose, repair, or commit.</span></footer>\n  <script src=\"dashboard.js?v=20261023-signal-explainer\"></script>\n</body>\n</html>\n:root {\n  --bg: #0b1118;\n  --card: #111a24;\n  --card-2: #0e161f;\n  --line: #22303d;\n  --ink: #d9d3c4;\n  --muted: #8fa3b2;\n  --amber: #f2b84b;\n  --coral: #d9685f;\n  --green: #6fcf8a;\n  --blue: #6db3f2;\n  --mono: \"SFMono-Regular\", Menlo, Consolas, \"Liberation Mono\", monospace;\n}\n* { box-sizing: border-box; }\nhtml, body { margin: 0; background: var(--bg); color: var(--ink); font: 14px/1.4 -apple-system, \"Segoe UI\", Roboto, \"Noto Sans\", sans-serif; }\n.mono { font-family: var(--mono); }\n.bar { display: flex; justify-content: space-between; align-items: center; padding: 10px 18px; border-bottom: 1px solid var(--line); background: #0d1520; }\n.bar.foot { border-top: 1px solid var(--line); border-bottom: 0; color: var(--muted); font-size: 12px; }\n.brand { font-weight: 700; letter-spacing: .08em; color: var(--amber); }\n.sub { margin-left: 10px; color: var(--muted); }\n.status { display: flex; gap: 10px; align-items: center; font-size: 12px; }\n.paper-link { color: var(--ink); text-decoration: none; border: 1px solid var(--line); background: var(--card); border-radius: 999px; padding: 3px 9px; }\n.paper-link:hover, .paper-link:focus-visible { color: var(--amber); border-color: #5a4a1e; outline: none; }\n.pill { padding: 3px 9px; border-radius: 999px; border: 1px solid var(--line); background: var(--card); }\n.pill.waiting { color: var(--muted); }\n.pill.live { color: var(--green); border-color: #2c5a3a; }\n.pill.boundary { color: var(--amber); border-color: #5a4a1e; }\n.grid {\n  display: grid;\n  grid-template-columns: 3fr 2fr;\n  grid-template-rows: auto auto auto;\n  grid-template-areas:\n    \"game nebula\"\n    \"game metrics\"\n    \"timeline minimap\"\n    \"log log\";\n  gap: 12px; padding: 12px 18px;\n}\n.card { background: var(--card); border: 1px solid var(--line); border-radius: 10px; padding: 10px 12px; min-width: 0; }\n.card-head { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; margin-bottom: 6px; }\n.card-head h2 { font-size: 13px; margin: 0; letter-spacing: .04em; text-transform: uppercase; color: var(--amber); }\nh3 { font-size: 12px; margin: 12px 0 4px; color: var(--ink); text-transform: uppercase; letter-spacing: .04em; }\n.hint { color: var(--muted); font-size: 11px; }\n.game { grid-area: game; }\n/* D-070: aspect-ratio alone let the embedded canvas shrink below the game's\n   authored 1280x720 layout budget on typical desktop grid widths, so the\n   bottom ledger/action panel (percentage-anchored in harbor_ledger_ui.gd)\n   lost its absolute pixel floor and the action buttons were clipped off the\n   bottom of the canvas. A min-height floor keeps the iframe at least as\n   tall as the project's native viewport regardless of the 3fr grid column\n   width, while aspect-ratio still governs wider layouts. */\n.frame-wrap { position: relative; width: 100%; aspect-ratio: 16 / 9; min-height: 720px; background: #000; border-radius: 6px; overflow: hidden; }\n#game { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }\n.nebula { grid-area: nebula; }\n.diagram-boundary { font-size: 11px; line-height: 1.5; color: var(--muted); margin: 0 0 8px; padding: 8px 10px; background: var(--card-2); border: 1px solid var(--line); border-left: 3px solid var(--amber); border-radius: 6px; }\n.diagram-boundary code { font-family: var(--mono); font-size: 10px; color: var(--ink); background: rgba(255,255,255,.06); padding: 1px 4px; border-radius: 3px; }\n#nebula { width: 100%; height: auto; display: block; }\n/* D-073: the settled stroke is the evidence; the legend reproduces exact swatches\n   (hatch / dash / ring) so no on-screen state is left to be guessed at. */\n.legend { margin: 6px 0 0; padding: 6px 8px; background: var(--card-2); border: 1px solid var(--line); border-radius: 6px; }\n.legend-rows { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 4px 14px; font-size: 11px; }\n.legend-rows li { display: flex; align-items: center; gap: 5px; }\n.legend-rows li b { font-weight: 600; color: var(--ink); }\n.legend-rows .glyph { color: var(--ink); font-size: 10px; min-width: 22px; }\n.swatch { width: 16px; height: 16px; flex: 0 0 16px; }\n.legend-counts { margin-top: 5px; font-size: 11px; color: var(--amber); }\n.last-trace { margin: 0; padding: 6px 8px; font-size: 10.5px; line-height: 1.45; color: var(--ink); background: var(--card-2); border: 1px solid var(--line); border-radius: 6px; white-space: pre; overflow-x: auto; max-height: 190px; }\n/* Reduced motion: dashboard.js already stops the pulse dots and substitutes stroke\n   weight for motion (traversed edges one point heavier); this only quiets the\n   remaining CSS animations so the evidence stays, the motion goes. */\n@media (prefers-reduced-motion: reduce) {\n  .edge-pulse { display: none; }\n  .flash-commit, .flash-hold { animation: none; }\n}\n.metrics { grid-area: metrics; }\n.kpis { display: grid; grid-template-columns: repeat(6, 1fr); gap: 6px; }\n.kpi { background: var(--card-2); border: 1px solid var(--line); border-radius: 8px; padding: 6px 8px; }\n.kpi .k { font-size: 10px; color: var(--muted); text-transform: uppercase; letter-spacing: .05em; }\n.kpi .v { font-size: 22px; font-weight: 700; color: var(--amber); }\n.kpi .v.coral { color: var(--coral); }\n/* Narrow viewports (390 px): the widened family table scrolls inside its card\n   instead of widening the page (2026-09-18 production check: page scrollWidth 517). */\n.tbl-wrap { max-width: 100%; overflow-x: auto; }\n.tbl { width: 100%; border-collapse: collapse; font-size: 12px; }\n.tbl th, .tbl td { text-align: left; padding: 3px 6px; border-bottom: 1px solid var(--line); vertical-align: top; }\n.tbl th { color: var(--muted); font-weight: 500; }\n.tbl td.num { text-align: right; font-family: var(--mono); }\n.bar-cell { position: relative; }\n.bar-fill { position: absolute; left: 0; top: 4px; bottom: 4px; background: rgba(217, 104, 95, .35); border-radius: 3px; }\n.chain { margin: 0; padding-left: 18px; font-size: 11px; color: var(--muted); }\n.chain li.head { color: var(--green); }\n.chain li .tag { color: var(--amber); }\n.timeline { grid-area: timeline; }\n#timeline { width: 100%; height: 150px; display: block; }\n.minimap { grid-area: minimap; }\n#minimap { width: 100%; height: auto; display: block; }\n.log { grid-area: log; }\n#log { max-height: 160px; overflow: auto; margin: 0; font-size: 11px; color: var(--muted); white-space: pre-wrap; }\n#log .commit { color: var(--green); }\n#log .hold { color: var(--coral); }\n#log .proposal { color: var(--amber); }\n.flash-commit { animation: flashc .8s ease-out; }\n.flash-hold { animation: flashh .8s ease-out; }\n@keyframes flashc { from { box-shadow: 0 0 0 3px rgba(111,207,138,.8);} to { box-shadow: none; } }\n@keyframes flashh { from { box-shadow: 0 0 0 3px rgba(217,104,95,.8);} to { box-shadow: none; } }\n@media (max-width: 1100px) {\n  .grid { grid-template-columns: 1fr; grid-template-areas: \"game\" \"nebula\" \"metrics\" \"timeline\" \"minimap\" \"log\"; }\n  /* Single-column stack already gives the game area the full viewport\n     width, so aspect-ratio alone yields a tall-enough frame; the desktop\n     720px floor would otherwise force excess scroll on narrow screens. */\n  .frame-wrap { min-height: 0; }\n}\n@media (max-width: 720px) {\n  .kpis { grid-template-columns: repeat(3, 1fr); }\n  .bar { flex-wrap: wrap; gap: 6px; }\n}\n\n/* Gameplay-focused dashboard surface. Existing trace styles remain available inside details. */\n:root { --bg:#091119; --card:#101b26; --card-2:#0b151e; --line:#2b3c4b; --ink:#f0eee7; --muted:#b3c2cd; --amber:#ffd166; --coral:#ff8378; --green:#7be29b; --blue:#8bc7ff; --gray:#c1cbd3; }\nhtml,body { min-height:100%; background:var(--bg); color:var(--ink); font-size:15px; line-height:1.45; }\nbody { overflow-x:hidden; }\n.topbar { display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:16px; padding:10px 20px; min-height:62px; border-bottom:1px solid var(--line); background:#0c1721; }\n.topbar .title { display:flex; flex-wrap:wrap; align-items:baseline; gap:12px; min-width:0; white-space:normal; }\n.brand { font-size:15px; }\n.sub { color:var(--muted); font-size:14px; }\n.top-metrics { display:flex; flex-wrap:wrap; max-width:100%; align-items:center; justify-content:center; gap:clamp(12px,2vw,30px); }\n.top-metrics span { display:grid; grid-template-columns:auto; justify-items:center; line-height:1.1; }\n.top-metrics b { font-size:17px; color:var(--amber); font-variant-numeric:tabular-nums; }\n.top-metrics b.coral { color:var(--coral); }\n.top-metrics small { margin-top:3px; color:var(--muted); font-size:12px; }\n.pill { max-width:100%; font-size:13px; white-space:normal; overflow-wrap:anywhere; }\n.dashboard { display:grid; grid-template-columns:minmax(0,2fr) minmax(310px,1fr); grid-template-areas:\"game rail\" \"action rail\" \"timeline timeline\" \"engineering engineering\"; gap:14px; width:min(100%,1800px); margin:0 auto; padding:14px 18px 24px; }\n.card { min-width:0; padding:14px 16px; border-radius:12px; background:var(--card); border-color:var(--line); }\n.card-head { flex-wrap:wrap; align-items:flex-start; gap:12px; margin-bottom:10px; }\n.card-head h1,.card-head h2 { margin:0; color:var(--amber); font-size:15px; line-height:1.3; letter-spacing:.045em; }\n.card-head h1 { color:var(--ink); font-size:18px; letter-spacing:0; text-transform:none; }\n.card-head h2 { text-transform:uppercase; }\n.hint { color:var(--muted); font-size:13px; line-height:1.4; }\n.game { grid-area:game; }\n.frame-wrap { min-height:720px; aspect-ratio:16/9; border-radius:8px; background:#000; }\n#game { position:absolute; inset:0; width:100%; height:100%; border:0; }\n.rail { grid-area:rail; display:flex; flex-direction:column; gap:14px; min-width:0; }\n.quest-card,.minimap,.recent-card { min-width:0; }\n.quest-objective { margin:6px 0 12px; color:var(--ink); font-size:18px; font-weight:650; line-height:1.35; }\n.quest-steps { display:grid; gap:7px; list-style:none; margin:0; padding:0; }\n.quest-step { display:grid; grid-template-columns:2em minmax(0,1fr); align-items:start; gap:8px; padding:8px 9px; border:1px solid var(--line); border-radius:8px; color:var(--muted); background:var(--card-2); font-size:14px; line-height:1.35; }\n.quest-step .step-mark { display:grid; place-items:center; width:1.7em; height:1.7em; border:1px solid currentColor; border-radius:50%; font-size:13px; font-weight:700; }\n.quest-step.done { color:var(--green); }\n.quest-step.current { border-color:#80662d; color:var(--ink); background:#211f18; }\n.quest-step.current .step-mark { color:var(--amber); }\n.quest-step .step-state { display:block; color:var(--muted); font-size:12px; }\n.quest-note,.map-focus,.empty-note { margin:10px 0 0; color:var(--muted); font-size:13px; }\n.minimap svg { display:block; width:100%; max-height:280px; }\n.map-focus { min-height:1.4em; }\n.recent-actions { display:grid; gap:0; list-style:none; margin:0; padding:0; }\n.recent-actions li { display:grid; grid-template-columns:auto minmax(0,1fr); gap:9px; padding:9px 0; border-bottom:1px solid var(--line); font-size:14px; }\n.recent-actions li:last-child { border-bottom:0; }\n.action-tag { align-self:start; min-width:76px; padding:2px 6px; border:1px solid currentColor; border-radius:5px; text-align:center; font-family:var(--mono); font-size:12px; font-weight:700; text-transform:uppercase; }\n.action-tag.commit { color:var(--green); }\n.action-tag.hold { color:var(--coral); }\n.action-summary { color:var(--ink); overflow-wrap:anywhere; }\n.action-card { grid-area:action; }\n.action-head { align-items:center; }\n.action-head h2 { margin-bottom:3px; }\n.action-head p { margin:0; }\n.readout-controls { display:flex; flex-wrap:wrap; justify-content:flex-end; gap:8px; }\n.control-button { min-height:42px; padding:8px 13px; border:1px solid #66819a; border-radius:8px; color:var(--ink); background:#1a2b3a; font:inherit; font-weight:650; cursor:pointer; }\n.control-button:hover { border-color:var(--amber); background:#24384a; }\n.control-button.secondary { color:var(--amber); border-color:#80662d; background:#211f18; }\n.control-button:focus-visible,.history-select:focus-visible,.paper-link:focus-visible,summary:focus-visible { outline:3px solid var(--amber); outline-offset:3px; }\n.action-outcome { margin:8px 0 6px; font-size:19px; font-weight:650; line-height:1.35; overflow-wrap:anywhere; }\n.action-next { margin:0 0 10px; padding:9px 11px; border-left:3px solid var(--amber); color:var(--ink); background:#191d1d; font-size:14px; overflow-wrap:anywhere; }\n.trace-state { margin:10px 0; padding:8px 10px; border:1px solid var(--line); border-radius:7px; color:var(--muted); background:var(--card-2); font-weight:650; }\n.trace-state[data-state=\"available\"] { color:var(--blue); }\n.trace-state[data-state=\"legacy\"] { color:var(--amber); border-color:#80662d; }\n.trace-state[data-state=\"missing\"] { color:var(--coral); border-color:#84443f; }\n.action-checks { display:grid; grid-template-columns:repeat(auto-fit,minmax(min(100%,150px),1fr)); gap:8px; list-style:none; margin:0; padding:0; }\n.check-item { min-width:0; padding:9px 10px; border:1px solid var(--line); border-radius:8px; background:var(--card-2); }\n.check-item .check-heading { display:flex; min-width:0; overflow-wrap:anywhere; align-items:center; gap:7px; font-weight:700; font-size:14px; }\n.check-item .check-glyph { flex:0 0 1em; min-width:1em; text-align:center; font-family:var(--mono); font-weight:800; }\n.check-item .check-code,.check-item .check-family { display:block; margin-top:3px; color:var(--muted); font:12px/1.35 var(--mono); overflow-wrap:anywhere; }\n.check-item[data-state=\"pass\"] { border-color:#3e7751; }\n.check-item[data-state=\"pass\"] .check-heading { color:var(--green); }\n.check-item[data-state=\"fail\"] { border-color:#984f48; background:#251716; }\n.check-item[data-state=\"fail\"] .check-heading { color:var(--coral); }\n.check-item[data-state=\"skipped\"] .check-heading { color:var(--gray); }\n.check-item[data-state=\"not-evaluated\"] .check-heading { color:var(--muted); }\n.check-item[data-state=\"missing\"] { border-style:dashed; border-color:#80662d; }\n.check-item[data-state=\"missing\"] .check-heading { color:var(--amber); }\n.legacy-note { margin:10px 0 0; padding:9px 11px; border:1px solid #80662d; border-radius:7px; color:var(--amber); background:#211f18; font-size:14px; }\n.action-history-head { display:flex; justify-content:space-between; align-items:baseline; gap:10px; margin-top:14px; }\n.action-history-head h3 { margin:0; font-size:14px; }\n.action-history { display:flex; gap:7px; overflow-x:auto; list-style:none; margin:8px 0 0; padding:2px 1px 8px; scrollbar-color:#526a7d transparent; }\n.action-history li { flex:0 0 auto; }\n.history-select { min-height:42px; padding:6px 9px; border:1px solid var(--line); border-radius:7px; color:var(--ink); background:var(--card-2); text-align:left; cursor:pointer; }\n.history-select[aria-current=\"true\"] { border-color:var(--amber); box-shadow:inset 0 0 0 1px var(--amber); }\n.history-select .history-result { display:block; font-size:12px; font-weight:700; text-transform:uppercase; }\n.history-select .history-operation { display:block; max-width:180px; overflow:hidden; color:var(--muted); font-size:12px; text-overflow:ellipsis; white-space:nowrap; }\n.timeline { grid-area:timeline; }\n#timeline { width:100%; height:170px; }\n.engineering { grid-area:engineering; }\n.engineering > summary { display:flex; align-items:center; gap:12px; min-height:42px; color:var(--ink); font-size:15px; font-weight:700; cursor:pointer; }\n.engineering > summary .pill { margin-left:auto; }\n.engineering-content { display:grid; gap:14px; padding-top:12px; }\n.engineering-status { display:flex; align-items:center; gap:10px; color:var(--muted); }\n.nebula,.metrics,.log { grid-area:auto; }\n.diagram-boundary { color:var(--muted); font-size:13px; line-height:1.55; }\n.legend-rows { font-size:12px; }\n.last-trace { font-size:12px; }\n.kpis { grid-template-columns:repeat(auto-fit,minmax(120px,1fr)); }\n.kpi .k { color:var(--muted); font-size:12px; }\n.kpi .v { font-size:20px; }\n.tbl { min-width:660px; font-size:13px; }\n#log { max-height:240px; font-size:12px; }\n.bar.foot { padding:12px 20px; font-size:13px; line-height:1.45; }\n@media (max-width:1100px) {\n  .topbar { flex-wrap:wrap; }\n  .dashboard { grid-template-columns:minmax(0,1fr); grid-template-areas:\"game\" \"rail\" \"action\" \"timeline\" \"engineering\"; }\n  .rail { display:grid; grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr)); align-items:start; }\n  .frame-wrap { min-height:720px; }\n}\n@media (max-width:720px) {\n  .topbar { align-items:flex-start; padding:10px 12px; }\n  .topbar .title { width:100%; }\n  .top-metrics { justify-content:space-between; width:100%; gap:6px; }\n  .top-metrics small { font-size:11px; }\n  .topbar > .pill { margin-left:auto; }\n  .dashboard { gap:10px; padding:10px 10px 18px; }\n  .card { padding:12px; }\n  .card-head { flex-wrap:wrap; }\n  .card-head h1 { font-size:17px; }\n  .game .card-head .hint { width:100%; }\n  .frame-wrap { min-height:720px; }\n  .rail { grid-template-columns:minmax(0,1fr); gap:10px; }\n  .action-head { align-items:flex-start; }\n  .readout-controls { width:100%; justify-content:flex-start; }\n  .action-outcome { font-size:18px; }\n  .action-checks { grid-template-columns:repeat(auto-fit,minmax(138px,1fr)); }\n  .engineering > summary { flex-wrap:wrap; }\n  .engineering > summary .pill { margin-left:0; }\n  .engineering-status { flex-wrap:wrap; }\n  .bar.foot { padding:12px; }\n}\n@media (prefers-reduced-motion:reduce) {\n  *,*::before,*::after { scroll-behavior:auto !important; animation-duration:.01ms !important; animation-iteration-count:1 !important; transition-duration:.01ms !important; }\n  .edge-pulse { display:none; }\n}\n\n/* Signal explainer and comparison lanes: semantic labels stay separate from the\n   legacy six-family trace, while native lists/tables provide a text equivalent. */\n.disclosure-live,.frozen-comparison { grid-column: 1 / -1; }\n.semantic-flow { display:grid; grid-template-columns:repeat(6,minmax(0,1fr)); gap:8px; }\n.semantic-step { min-width:0; padding:10px; border:1px solid var(--line); border-radius:8px; background:var(--card-2); }\n.semantic-step h3 { margin:0 0 5px; color:var(--amber); font-size:12px; }\n.semantic-step p { margin:0; color:var(--ink); overflow-wrap:anywhere; }\n.semantic-step .semantic-detail { display:block; margin-top:4px; color:var(--muted); font:12px/1.35 var(--mono); overflow-wrap:anywhere; }\n.semantic-step[data-state=\"unknown\"] { border-style:dashed; border-color:#80662d; }\n.semantic-step[data-state=\"unknown\"] h3,.unknown { color:var(--amber); }\n.disclosure-timeline { margin-top:14px; padding-top:12px; border-top:1px solid var(--line); }\n#disclosure-timeline { width:100%; height:180px; display:block; background:var(--card-2); border-radius:8px; }\n.disclosure-events { display:grid; gap:6px; list-style:none; margin:8px 0 0; padding:0; max-height:320px; overflow:auto; }\n.disclosure-event { display:grid; grid-template-columns:auto minmax(0,1fr); gap:8px; padding:8px 10px; border:1px solid var(--line); border-radius:7px; background:var(--card-2); }\n.disclosure-event .event-index { color:var(--amber); font:700 12px var(--mono); }\n.disclosure-event .event-main { min-width:0; }\n.disclosure-event .event-head { display:flex; flex-wrap:wrap; gap:8px; color:var(--ink); font-weight:650; }\n.disclosure-event .event-meta { margin-top:2px; color:var(--muted); font:12px/1.35 var(--mono); overflow-wrap:anywhere; }\n.disclosure-event[data-outcome=\"denied\"] { border-color:#84443f; }\n.disclosure-event[data-outcome=\"unknown\"] { border-style:dashed; border-color:#80662d; }\n.comparison-grid { display:grid; grid-template-columns:minmax(0,1.1fr) minmax(360px,1fr); gap:12px; align-items:start; }\n.comparison-grid > div:first-child { min-width:0; overflow-x:auto; }\n#comparison-graph { width:100%; min-width:640px; height:auto; min-height:220px; display:block; background:var(--card-2); border-radius:8px; }\n.comparison-legend { display:flex; flex-wrap:wrap; gap:6px 14px; margin-top:8px; color:var(--muted); font-size:12px; }\n.comparison-legend span { display:inline-flex; align-items:center; gap:5px; }\n.comparison-legend b { color:var(--ink); }\n#comparison-matrix { min-width:620px; }\n#comparison-matrix td[data-status=\"unreported\"] { color:var(--amber); border-style:dashed; }\n#comparison-matrix td[data-status=\"reported\"] { color:var(--green); }\n.comparison-note { margin:8px 0 0; color:var(--muted); font-size:12px; }\n@media (max-width:1100px) {\n  .semantic-flow { grid-template-columns:repeat(3,minmax(0,1fr)); }\n  .comparison-grid { grid-template-columns:minmax(0,1fr); }\n}\n@media (max-width:720px) {\n  .semantic-flow { grid-template-columns:minmax(0,1fr); }\n  .disclosure-event { grid-template-columns:1fr; }\n  #disclosure-timeline { height:200px; }\n}\n.rule-boundaries { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:8px; margin-top:12px; }\n.rule-boundary { min-width:0; padding:9px 10px; border:1px solid var(--line); border-radius:7px; background:var(--card-2); }\n.rule-boundary h3 { margin:0 0 4px; color:var(--amber); font-size:12px; }\n.rule-boundary p { margin:0; color:var(--muted); font-size:12px; overflow-wrap:anywhere; }\n@media (max-width:720px) { .rule-boundaries { grid-template-columns:minmax(0,1fr); } }\n/* TRACE-RPG live commit-gate dashboard.\n *\n * Presentation-only consumer of the game's postMessage mirror (D-065). It draws an\n * AgentSight-style weighted pipeline (\"commit nebula\") as a per-proposal\n * evaluation trace (D-073), a `top`-like metrics panel bound to the paper's\n * predicate families, an event timeline, and a harbor mini-map. Nothing here can\n * propose, repair, or commit; it renders what the hard writer already returned.\n * Exposed as window.__traceDashboard for browser automation.\n *\n * Trace contract (engine `game_3d.gd::dashboard_trace`, attached as `payload.trace`\n * on `commit` and `hold` envelopes):\n *   checks:          [{code, gate, outcome: \"pass\"|\"fail\"}...]  in execution order\n *   evaluated_gates: [gate...]                                   families consulted\n *   held_at:         <code> or \"\"                                first failing check\n *   short_circuit:   bool                                        engine stopped early\n *   skipped:         [{code, gate}...]   in-scope checks never reached after the hold\n *   out_of_scope:    [family...]         families never consulted for this operation\n *   family_states:   {FAMILY: \"pass\"|\"fail\"|\"skipped\"|\"out_of_scope\"}  every family,\n *                    exactly one explicit state, no default\n * Rules (Aside deep research 2026-09-18, P/_workspace/current/intake/\n * aside-research-2026-09-18-commit-gate-trace-encoding.md):\n *   - node state follows explicit `family_states`, unless a check outcome is\n *     unreported. Missing/unknown evidence renders \"state missing\" and logs\n *     console.error, never a neutral or a pass;\n *   - only edges the engine actually traversed animate; the settled stroke, not the\n *     motion, carries the evidence; prefers-reduced-motion substitutes weight for\n *     motion instead of deleting the evidence;\n *   - green/coral are verdict colours reserved for COMMIT/HOLD and the timeline;\n *     pass is blue, fail is coral + ring, skipped is dashed/no fill, out of scope\n *     is hatched;\n *   - legend rows are generated from the states present in the current event with\n *     pytest-style separate counts, never a ratio over the six families.\n * Envelopes without `payload.trace` (builds older than D-073) fall back to the\n * schema-only pulse of D-065 and are tagged `legacy: schema-only` in the feed.\n */\n(() => {\n  \"use strict\";\n  const CHANNEL = \"trace-rpg-dashboard\";\n  const SVG_NS = \"http://www.w3.org/2000/svg\";\n  const FAMILIES = [\"POLICY\", \"PRECONDITION\", \"REACHABILITY\", \"KNOWLEDGE\", \"DISCLOSURE\", \"QUEST STAGE\"];\n  const COLORS = {\n    amber: \"#f2b84b\", coral: \"#d9685f\", green: \"#6fcf8a\", blue: \"#6db3f2\", blueFill: \"#1d3a55\",\n    muted: \"#8fa3b2\", gray: \"#7d8a95\", faint: \"#3a4653\", line: \"#22303d\", ink: \"#d9d3c4\", card: \"#0e161f\",\n  };\n  // Node encodings: colour + glyph + word on every node (WCAG 1.4.1 double encoding).\n  const STATE_STYLE = {\n    pass: { fill: COLORS.blueFill, stroke: COLORS.blue, width: 2, dash: \"\", glyph: \"v\", word: \"passed\", ring: false },\n    fail: { fill: \"#3a1f1c\", stroke: COLORS.coral, width: 3, dash: \"\", glyph: \"x\", word: \"failed\", ring: true },\n    skipped: { fill: \"none\", stroke: COLORS.gray, width: 2, dash: \"6 3\", glyph: \"->|\", word: \"skipped\", ring: false },\n    out_of_scope: { fill: \"url(#hatch-oos)\", stroke: COLORS.gray, width: 1.5, dash: \"\", glyph: \"n/a\", word: \"not evaluated\", ring: false },\n    missing: { fill: \"#4a3a10\", stroke: COLORS.amber, width: 3, dash: \"2 2\", glyph: \"!\", word: \"state missing\", ring: true },\n    legacy: { fill: \"none\", stroke: COLORS.amber, width: 1.5, dash: \"3 3\", glyph: \"?\", word: \"no trace (legacy)\", ring: false },\n    idle: { fill: COLORS.card, stroke: COLORS.muted, width: 1.5, dash: \"\", glyph: \"\", word: \"no trace yet\", ring: false },\n  };\n  const LEGEND_WORD = {\n    pass: \"evaluated and passed\",\n    fail: \"evaluated and failed (held, state unchanged)\",\n    skipped: \"skipped: in scope, not run after the hold (short-circuit)\",\n    out_of_scope: \"not evaluated: out of scope for this operation type\",\n    missing: \"state missing from payload (renderer refuses to guess)\",\n    legacy: \"legacy envelope without trace: no per-check evidence\",\n  };\n  const VERDICT_STYLE = {\n    commit: { fill: \"#173a25\", stroke: COLORS.green, width: 3, dash: \"\", glyph: \"\", word: \"committed\", ring: false },\n    hold: { fill: \"#3a1f1c\", stroke: COLORS.coral, width: 3, dash: \"\", glyph: \"\", word: \"held\", ring: true },\n    terminal_idle: { fill: COLORS.card, stroke: COLORS.muted, width: 1.5, dash: \"\", glyph: \"\", word: \"\", ring: false },\n  };\n  const REDUCED_MOTION = typeof window.matchMedia === \"function\" && window.matchMedia(\"(prefers-reduced-motion: reduce)\").matches;\n\n  const state = {\n    connected: false,\n    session: null,\n    reference: null,\n    counts: { commits: 0, holds: 0, proposals: 0, dialogues: 0 },\n    holdsByGate: Object.fromEntries(FAMILIES.map((f) => [f, 0])),\n    codeCounts: {},\n    nodeWeight: {},\n    // Per-family evidence counters fed only by traces: checks the engine evaluated\n    // there (pass + fail). Never fed by legacy schema-only envelopes.\n    familyEval: Object.fromEntries(FAMILIES.map((f) => [f, { evaluated: 0, passed: 0, failed: 0 }])),\n    familyState: Object.fromEntries(FAMILIES.map((f) => [f, \"idle\"])),\n    lastTrace: null,\n    legendRows: [],\n    legacyEvents: 0,\n    traceErrors: 0,\n    pendingOperation: \"\",\n    hashChain: [],\n    lastSummary: null,\n    lastTick: null,\n    events: [],\n    trail: [],\n    player: null,\n    focus: \"\",\n    lastHoldGates: [],\n    episodeOver: false,\n    reducedMotion: REDUCED_MOTION,\n    startedAt: performance.now(),\n    verdicts: [],\n    selectedVerdictId: null,\n    verdictSerial: 0,\n    readoutFrozen: false,\n    pinnedVerdict: null,\n    metMira: false,\n    lastTickAt: null,\n    disclosureEvents: [],\n    latestExplanation: null,\n    comparison: null,\n  };\n  window.__traceDashboard = state;\n\n  const $ = (id) => document.getElementById(id);\n  const el = (name, attrs = {}, parent = null) => {\n    const node = document.createElementNS(SVG_NS, name);\n    for (const [k, v] of Object.entries(attrs)) node.setAttribute(k, String(v));\n    if (parent) parent.appendChild(node);\n    return node;\n  };\n  const short = (hash) => (hash ? `${hash.slice(0, 8)}…${hash.slice(-4)}` : \"—\");\n  const escapeHtml = (text) => String(text).replace(/[&<>\"']/g, (c) => ({ \"&\": \"&amp;\", \"<\": \"&lt;\", \">\": \"&gt;\", '\"': \"&quot;\", \"'\": \"&#39;\" }[c]));\n  function gateFamilies(gate) {\n    const seen = [];\n    for (const part of String(gate).split(\"/\")) {\n      const family = part.trim();\n      if (FAMILIES.includes(family) && !seen.includes(family)) seen.push(family);\n    }\n    return seen;\n  }\n\n  // ------------------------------------------------------------------ nebula\n  // Pipeline geometry mirrors Fig. 2 / Table II of the manuscript: proposer ->\n  // parser/contract -> six state-relative predicates -> commit | hold -> trace.\n  // The layout is the plan; the node states are the evidence for one proposal.\n  const NODES = {\n    proposer: { x: 54, y: 200, label: \"INTENT\", sub: \"player proposal a_t\", r: 26 },\n    parser: { x: 168, y: 200, label: \"PARSER\", sub: \"typed contract\", r: 22 },\n    POLICY: { x: 320, y: 40, label: \"v_policy\", sub: \"POLICY\", r: 18 },\n    PRECONDITION: { x: 320, y: 104, label: \"v_pre\", sub: \"PRECONDITION\", r: 18 },\n    REACHABILITY: { x: 320, y: 168, label: \"v_reach\", sub: \"REACHABILITY\", r: 18 },\n    KNOWLEDGE: { x: 320, y: 232, label: \"v_know\", sub: \"KNOWLEDGE\", r: 18 },\n    DISCLOSURE: { x: 320, y: 296, label: \"v_disc\", sub: \"DISCLOSURE\", r: 18 },\n    \"QUEST STAGE\": { x: 320, y: 360, label: \"v_quest\", sub: \"QUEST STAGE\", r: 18 },\n    commit: { x: 486, y: 130, label: \"COMMIT\", sub: \"T(c_t, a_t)\", r: 24 },\n    hold: { x: 486, y: 270, label: \"HOLD\", sub: \"state unchanged\", r: 24 },\n    trace: { x: 594, y: 200, label: \"TRACE\", sub: \"hash chain\", r: 22 },\n  };\n  const nebula = $(\"nebula\");\n  const defs = el(\"defs\", {}, nebula);\n  // One diagonal hatch only (two hatches are hard to tell apart); reserved for\n  // out-of-scope families. Dark-theme derivation of the Datawrapper pattern.\n  const hatch = el(\"pattern\", { id: \"hatch-oos\", width: 6, height: 6, patternTransform: \"rotate(45)\", patternUnits: \"userSpaceOnUse\" }, defs);\n  el(\"rect\", { width: 6, height: 6, fill: COLORS.card }, hatch);\n  el(\"line\", { x1: 0, y1: 0, x2: 0, y2: 6, stroke: COLORS.muted, \"stroke-width\": 2, \"stroke-opacity\": 0.55 }, hatch);\n  for (const [id, color] of [[\"arrow-blue\", COLORS.blue], [\"arrow-green\", COLORS.green], [\"arrow-coral\", COLORS.coral], [\"arrow-amber\", COLORS.amber]]) {\n    const marker = el(\"marker\", { id, viewBox: \"0 0 10 10\", refX: 9, refY: 5, markerWidth: 6, markerHeight: 6, orient: \"auto-start-reverse\", markerUnits: \"userSpaceOnUse\" }, defs);\n    el(\"path\", { d: \"M 0 0 L 10 5 L 0 10 z\", fill: color }, marker);\n  }\n  // \"Flow stopped here\": the edge into the failing check terminates in a square cap.\n  const stopMarker = el(\"marker\", { id: \"stop-coral\", viewBox: \"0 0 10 10\", refX: 8, refY: 5, markerWidth: 7, markerHeight: 7, orient: \"auto\", markerUnits: \"userSpaceOnUse\" }, defs);\n  el(\"rect\", { x: 2, y: 1, width: 7, height: 8, fill: COLORS.coral }, stopMarker);\n  const edgeLayer = el(\"g\", { id: \"edges\" }, nebula);\n  const pulseLayer = el(\"g\", { id: \"pulses\" }, nebula);\n  const nodeLayer = el(\"g\", { id: \"nodes\" }, nebula);\n  const noteLayer = el(\"g\", { id: \"boundary-note\" }, nebula);\n  const nodeEls = {};\n\n  for (const [id, n] of Object.entries(NODES)) {\n    const isFamily = FAMILIES.includes(id);\n    const g = el(\"g\", { class: `node${isFamily ? \" family\" : \"\"}`, \"data-id\": id, \"data-state\": isFamily ? \"idle\" : \"\" }, nodeLayer);\n    const halo = el(\"circle\", { cx: n.x, cy: n.y, r: n.r + 6, fill: \"none\", stroke: COLORS.line, \"stroke-width\": 1, opacity: 0.6 }, g);\n    const circle = el(\"circle\", { cx: n.x, cy: n.y, r: n.r, fill: COLORS.card, stroke: COLORS.muted, \"stroke-width\": 1.5 }, g);\n    const glyph = el(\"text\", { class: \"glyph\", x: n.x, y: n.y - (isFamily ? 4 : 0), \"text-anchor\": \"middle\", \"font-size\": isFamily ? 9 : 0, \"font-family\": \"Menlo, monospace\", fill: COLORS.ink }, g);\n    const label = el(\"text\", { class: \"label\", x: n.x, y: n.y + (isFamily ? 7 : 3), \"text-anchor\": \"middle\", \"font-size\": isFamily ? 8 : 9, \"font-family\": \"Menlo, monospace\", fill: COLORS.ink }, g);\n    label.textContent = n.label;\n    const sub = el(\"text\", { class: \"sub\", x: n.x, y: n.y + n.r + 11, \"text-anchor\": \"middle\", \"font-size\": 8, fill: COLORS.muted }, g);\n    sub.textContent = n.sub;\n    const word = el(\"text\", { class: \"word\", x: n.x, y: n.y + n.r + 20, \"text-anchor\": \"middle\", \"font-size\": 7.5, \"font-family\": \"Menlo, monospace\", fill: COLORS.muted }, g);\n    // The TRACE node sits at the right edge, so its weight goes above it, right-\n    // aligned to the viewport, instead of off-canvas to the right.\n    const weight = id === \"trace\"\n      ? el(\"text\", { class: \"weight\", x: 636, y: n.y - n.r - 4, \"text-anchor\": \"end\", \"font-size\": 7.5, \"font-family\": \"Menlo, monospace\", fill: COLORS.amber }, g)\n      : el(\"text\", { class: \"weight\", x: n.x + n.r + 3, y: n.y - n.r + 1, \"font-size\": 7.5, \"font-family\": \"Menlo, monospace\", fill: COLORS.amber }, g);\n    nodeEls[id] = { g, halo, circle, glyph, label, sub, word, weight, base: n.r, r: n.r };\n    state.nodeWeight[id] = 0;\n    if (isFamily) setFamilyState(id, \"idle\");\n    else if (id === \"commit\" || id === \"hold\") setTerminalState(id, \"terminal_idle\");\n  }\n\n  function paintNode(id, style) {\n    const n = nodeEls[id];\n    n.circle.setAttribute(\"fill\", style.fill);\n    n.circle.setAttribute(\"stroke\", style.stroke);\n    n.circle.setAttribute(\"stroke-width\", style.width);\n    if (style.dash) n.circle.setAttribute(\"stroke-dasharray\", style.dash); else n.circle.removeAttribute(\"stroke-dasharray\");\n    n.halo.setAttribute(\"stroke\", style.ring ? style.stroke : COLORS.line);\n    n.halo.setAttribute(\"stroke-width\", style.ring ? 1.5 : 1);\n    n.halo.setAttribute(\"opacity\", style.ring ? 0.9 : 0.6);\n    n.glyph.textContent = style.glyph;\n    n.word.setAttribute(\"fill\", style.stroke === COLORS.muted ? COLORS.muted : style.stroke);\n  }\n  function setFamilyState(family, name, detail = \"\") {\n    const style = STATE_STYLE[name] || STATE_STYLE.missing;\n    state.familyState[family] = name;\n    const n = nodeEls[family];\n    n.g.setAttribute(\"data-state\", name);\n    paintNode(family, style);\n    n.word.textContent = detail ? `${style.word} ${detail}` : style.word;\n  }\n  function setTerminalState(id, name) {\n    const style = VERDICT_STYLE[name];\n    const n = nodeEls[id];\n    n.g.setAttribute(\"data-state\", name === \"terminal_idle\" ? \"\" : style.word);\n    paintNode(id, style);\n    n.word.textContent = style.word;\n  }\n\n  // Edges end on the node rim (not the centre) so a persistent arrowhead / stop\n  // cap stays visible above the node circle whatever its current weight radius.\n  function edgePath(a, b) {\n    const A = NODES[a], B = NODES[b];\n    const ax = A.x + nodeEls[a].r, ay = A.y, bx = B.x - nodeEls[b].r, by = B.y;\n    const mx = (ax + bx) / 2;\n    return `M ${ax} ${ay} C ${mx} ${ay}, ${mx} ${by}, ${bx} ${by}`;\n  }\n  const EDGES = [\n    [\"proposer\", \"parser\"],\n    ...FAMILIES.map((f) => [\"parser\", f]),\n    ...FAMILIES.map((f) => [f, \"commit\"]),\n    ...FAMILIES.map((f) => [f, \"hold\"]),\n    [\"commit\", \"trace\"],\n    [\"hold\", \"trace\"],\n  ];\n  // The settled stroke is the evidence. `schema` is the plan (untraversed);\n  // everything else is set only from what the engine reported for this proposal.\n  const EDGE_STYLE = {\n    schema: { stroke: COLORS.line, width: 1.2, dash: \"\", opacity: 0.8, marker: \"\" },\n    traversed: { stroke: COLORS.blue, width: 2, dash: \"\", opacity: 1, marker: \"url(#arrow-blue)\" },\n    fail: { stroke: COLORS.coral, width: 3, dash: \"\", opacity: 1, marker: \"url(#stop-coral)\" },\n    commit: { stroke: COLORS.green, width: 2, dash: \"\", opacity: 1, marker: \"url(#arrow-green)\" },\n    hold: { stroke: COLORS.coral, width: 2, dash: \"\", opacity: 1, marker: \"url(#arrow-coral)\" },\n    skipped: { stroke: COLORS.gray, width: 1, dash: \"1 3\", opacity: 0.9, marker: \"\" },\n    out_of_scope: { stroke: COLORS.faint, width: 1, dash: \"1 3\", opacity: 0.7, marker: \"\" },\n    legacy: { stroke: COLORS.amber, width: 1.2, dash: \"3 3\", opacity: 0.8, marker: \"\" },\n  };\n  const edgeEls = {};\n  for (const [a, b] of EDGES) {\n    const path = el(\"path\", { class: \"edge\", \"data-edge\": `${a}>${b}`, \"data-kind\": \"schema\", d: edgePath(a, b), fill: \"none\" }, edgeLayer);\n    edgeEls[`${a}>${b}`] = path;\n    styleEdge(a, b, \"schema\");\n  }\n  function styleEdge(a, b, kind) {\n    const path = edgeEls[`${a}>${b}`];\n    if (!path) return;\n    const style = EDGE_STYLE[kind];\n    path.setAttribute(\"data-kind\", kind);\n    path.setAttribute(\"stroke\", style.stroke);\n    // Reduced motion: emphasis by weight instead of by pulse (MDN \"substitute,\n    // never delete\"): traversed strokes are one point heavier.\n    path.setAttribute(\"stroke-width\", REDUCED_MOTION && style.marker ? style.width + 1 : style.width);\n    path.setAttribute(\"opacity\", style.opacity);\n    if (style.dash) path.setAttribute(\"stroke-dasharray\", style.dash); else path.removeAttribute(\"stroke-dasharray\");\n    if (style.marker) path.setAttribute(\"marker-end\", style.marker); else path.removeAttribute(\"marker-end\");\n  }\n  function resetEdges() {\n    for (const [a, b] of EDGES) styleEdge(a, b, \"schema\");\n  }\n  function refreshEdgesTouching(id) {\n    for (const [a, b] of EDGES) if (a === id || b === id) edgeEls[`${a}>${b}`].setAttribute(\"d\", edgePath(a, b));\n  }\n\n  // AgentSight idiom: node size encodes weight; growth is logarithmic so the\n  // graph stays readable across a long session. Family weight = checks the\n  // engine evaluated there (pass + fail, from traces); other nodes = envelopes\n  // routed through them. Weights are recorded synchronously at event time so the\n  // DOM always carries the evidence even while the motion is still playing.\n  function weigh(id, delta, tag) {\n    state.nodeWeight[id] = (state.nodeWeight[id] || 0) + delta;\n    const n = nodeEls[id];\n    if (!n) return;\n    // Growth is capped so a grown node never runs into the label of the next one.\n    n.r = n.base + Math.min(6, 3 * Math.log2(1 + state.nodeWeight[id]));\n    n.circle.setAttribute(\"r\", n.r);\n    n.halo.setAttribute(\"r\", n.r + 6);\n    n.weight.textContent = state.nodeWeight[id] ? `${tag} x${state.nodeWeight[id]}` : \"\";\n    refreshEdgesTouching(id);\n  }\n  function bump(id) {\n    const n = nodeEls[id];\n    if (!n || REDUCED_MOTION) return;\n    const settled = n.circle.getAttribute(\"stroke-width\");\n    n.circle.setAttribute(\"stroke-width\", Number(settled) + 1.5);\n    setTimeout(() => n.circle.setAttribute(\"stroke-width\", settled), 700);\n  }\n\n  const pulses = [];\n  function pulse(a, b, color, delay = 0) {\n    if (REDUCED_MOTION) return;\n    const path = edgeEls[`${a}>${b}`];\n    if (!path) return;\n    const dot = el(\"circle\", { class: \"edge-pulse\", r: 4, fill: color }, pulseLayer);\n    pulses.push({ path, dot, t0: performance.now() + delay, dur: 550 });\n  }\n  function animatePulses(now) {\n    for (let i = pulses.length - 1; i >= 0; i -= 1) {\n      const p = pulses[i];\n      const u = (now - p.t0) / p.dur;\n      if (u < 0) continue;\n      if (u >= 1) { p.dot.remove(); pulses.splice(i, 1); continue; }\n      const len = p.path.getTotalLength();\n      const pt = p.path.getPointAtLength(len * u);\n      p.dot.setAttribute(\"cx\", pt.x);\n      p.dot.setAttribute(\"cy\", pt.y);\n      p.dot.setAttribute(\"opacity\", 1 - u * 0.5);\n    }\n    requestAnimationFrame(animatePulses);\n  }\n  requestAnimationFrame(animatePulses);\n\n  // Boundary note inside the viewport so exports carry it (research R10);\n  // wording: Aside report section 4, Version A, \"commit\" adapted to \"proposal\".\n  const NOTE_LINES = [\n    \"This is a per-proposal evaluation trace, not a schematic. Each node shows what the engine actually did for this proposal:\",\n    \"checks that ran and passed, the check that failed, checks skipped after the first failure, and families out of scope for this\",\n    \"operation type. Families marked \\\"not evaluated\\\" never ran. That is not a pass, and says nothing about whether they would hold.\",\n  ];\n  NOTE_LINES.forEach((line, i) => {\n    const t = el(\"text\", { class: \"boundary-line\", x: 6, y: 412 + i * 10, \"font-size\": 8, fill: COLORS.muted }, noteLayer);\n    t.textContent = line;\n  });\n  const stamp = el(\"text\", { id: \"trace-stamp\", x: 634, y: 12, \"text-anchor\": \"end\", \"font-size\": 7.5, \"font-family\": \"Menlo, monospace\", fill: COLORS.amber }, noteLayer);\n  stamp.textContent = \"engineering demonstration | no proposal yet\";\n\n  // ------------------------------------------------------------------ trace\n  function normalizeTrace(raw) {\n    if (!raw || typeof raw !== \"object\") return null;\n    const checks = (Array.isArray(raw.checks) ? raw.checks : []).map((c) => ({\n      code: String(c.code || \"\"), gate: String(c.gate || \"\"), outcome: c.outcome === \"fail\" ? \"fail\" : c.outcome === \"pass\" ? \"pass\" : \"missing\", families: gateFamilies(c.gate),\n    }));\n    const familyStates = raw.family_states && typeof raw.family_states === \"object\" ? raw.family_states : {};\n    const states = {};\n    const missing = [];\n    for (const f of FAMILIES) {\n      const s = familyStates[f];\n      if (s === \"pass\" || s === \"fail\" || s === \"skipped\" || s === \"out_of_scope\") states[f] = s;\n      else { states[f] = \"missing\"; missing.push(f); }\n    }\n    // An unreported check is not evidence of a family pass, even if the\n    // supplied aggregate claims one. Keep the graph and readout fail-closed.\n    for (const check of checks) {\n      if (check.outcome !== \"missing\") continue;\n      for (const f of check.families) {\n        states[f] = \"missing\";\n        if (!missing.includes(f)) missing.push(f);\n      }\n    }\n    return {\n      checks,\n      evaluatedGates: Array.isArray(raw.evaluated_gates) ? raw.evaluated_gates.map(String) : [],\n      heldAt: String(raw.held_at || \"\"),\n      shortCircuit: !!raw.short_circuit,\n      skipped: (Array.isArray(raw.skipped) ? raw.skipped : []).map((s) => ({ code: String(s.code || \"\"), gate: String(s.gate || \"\"), families: gateFamilies(s.gate) })),\n      outOfScope: (Array.isArray(raw.out_of_scope) ? raw.out_of_scope : []).map(String),\n      states,\n      missing,\n    };\n  }\n  function traceSummaryText(t) {\n    return `${t.counts.passed} passed, ${t.counts.failed} failed, ${t.counts.skipped} skipped (checks), ${t.counts.not_evaluated} not evaluated (families)`;\n  }\n  function showTraceFlow(kind, payload, envelope) {\n    const trace = normalizeTrace(payload.trace);\n    const operation = String(payload.operation || state.pendingOperation || \"unknown operation\");\n    state.pendingOperation = \"\";\n    // Terminal nodes and edges show this proposal only; the previous verdict is\n    // not allowed to linger next to a new one.\n    resetEdges();\n    setTerminalState(\"commit\", \"terminal_idle\");\n    setTerminalState(\"hold\", \"terminal_idle\");\n    weigh(\"proposer\", 1, \"routed\"); bump(\"proposer\");\n    weigh(\"parser\", 1, \"routed\"); setTimeout(() => bump(\"parser\"), 350);\n    styleEdge(\"proposer\", \"parser\", \"traversed\");\n    pulse(\"proposer\", \"parser\", COLORS.blue);\n    if (!trace) return showLegacyFlow(kind, payload, envelope, operation);\n\n    if (trace.missing.length) {\n      state.traceErrors += 1;\n      console.error(`dashboard trace: family/check states missing ${trace.missing.join(\", \")} for ${operation} (seq ${envelope.seq}); rendering \"state missing\", not a pass`);\n    }\n    const codesByFamily = Object.fromEntries(FAMILIES.map((f) => [f, []]));\n    const touched = new Set();\n    const STEP = 260;\n    let step = 0;\n    for (const check of trace.checks) {\n      const color = check.outcome === \"pass\" ? COLORS.blue : check.outcome === \"fail\" ? COLORS.coral : COLORS.amber;\n      for (const f of check.families) {\n        touched.add(f);\n        if (check.outcome === \"pass\" || check.outcome === \"fail\") {\n          state.familyEval[f].evaluated += 1;\n          state.familyEval[f][check.outcome === \"pass\" ? \"passed\" : \"failed\"] += 1;\n          weigh(f, 1, \"evaluated\");\n        }\n        if (check.outcome === \"fail\") codesByFamily[f].push(check.code);\n        pulse(\"parser\", f, color, 450 + step * STEP);\n        setTimeout(() => bump(f), 900 + step * STEP);\n      }\n      step += 1;\n    }\n    for (const f of FAMILIES) {\n      const s = trace.states[f];\n      setFamilyState(f, s, s === \"fail\" ? codesByFamily[f].join(\"+\") : \"\");\n      if (s === \"pass\" || s === \"fail\") styleEdge(\"parser\", f, s === \"fail\" ? \"fail\" : \"traversed\");\n      else if (s === \"skipped\") styleEdge(\"parser\", f, \"skipped\");\n      else if (s === \"out_of_scope\") styleEdge(\"parser\", f, \"out_of_scope\");\n      // \"missing\" keeps the schema edge: no evidence either way.\n    }\n    const routeAt = 450 + step * STEP;\n    if (kind === \"commit\") {\n      for (const f of FAMILIES) if (trace.states[f] === \"pass\") { styleEdge(f, \"commit\", \"commit\"); pulse(f, \"commit\", COLORS.green, routeAt); }\n      setTerminalState(\"commit\", \"commit\");\n      weigh(\"commit\", 1, \"routed\"); setTimeout(() => bump(\"commit\"), routeAt + 450);\n      styleEdge(\"commit\", \"trace\", \"commit\"); pulse(\"commit\", \"trace\", COLORS.green, routeAt + 500);\n    } else {\n      for (const f of FAMILIES) if (trace.states[f] === \"fail\") { styleEdge(f, \"hold\", \"hold\"); pulse(f, \"hold\", COLORS.coral, routeAt); }\n      setTerminalState(\"hold\", \"hold\");\n      weigh(\"hold\", 1, \"routed\"); setTimeout(() => bump(\"hold\"), routeAt + 450);\n      styleEdge(\"hold\", \"trace\", \"hold\"); pulse(\"hold\", \"trace\", COLORS.coral, routeAt + 500);\n    }\n    weigh(\"trace\", 1, \"routed\"); setTimeout(() => bump(\"trace\"), routeAt + 950);\n\n    const counts = {\n      passed: trace.checks.filter((c) => c.outcome === \"pass\").length,\n      failed: trace.checks.filter((c) => c.outcome === \"fail\").length,\n      skipped: trace.skipped.length,\n      not_evaluated: FAMILIES.filter((f) => trace.states[f] === \"out_of_scope\").length,\n      missing: trace.missing.length,\n    };\n    state.lastTrace = { kind, operation, seq: envelope.seq, t_ms: envelope.t_ms, legacy: false, trace, counts };\n    renderLegend(); renderLastTrace();\n  }\n  // Envelopes from builds older than D-073 carry no per-check evidence. Keep the\n  // D-065 schema pulse so an old build still shows life, but paint it amber\n  // (verdict-neutral), feed no family weights, and say so in every surface.\n  function showLegacyFlow(kind, payload, envelope, operation) {\n    state.legacyEvents += 1;\n    const heldFamilies = new Set(kind === \"hold\" ? (payload.gates || []).flatMap(gateFamilies) : []);\n    const codes = kind === \"hold\" ? (payload.codes || []).map(String) : [];\n    FAMILIES.forEach((f, i) => {\n      const held = heldFamilies.has(f);\n      setFamilyState(f, held ? \"fail\" : \"legacy\", held ? codes.join(\"+\") : \"\");\n      styleEdge(\"parser\", f, held ? \"fail\" : \"legacy\");\n      pulse(\"parser\", f, held ? COLORS.coral : COLORS.amber, 450 + i * 40);\n      setTimeout(() => bump(f), 900 + i * 40);\n      if (kind === \"commit\") { styleEdge(f, \"commit\", \"legacy\"); pulse(f, \"commit\", COLORS.amber, 1000 + i * 40); }\n      else if (held) { styleEdge(f, \"hold\", \"hold\"); pulse(f, \"hold\", COLORS.coral, 1000 + i * 40); }\n    });\n    const terminal = kind === \"commit\" ? \"commit\" : \"hold\";\n    setTerminalState(\"commit\", \"terminal_idle\");\n    setTerminalState(\"hold\", \"terminal_idle\");\n    setTerminalState(terminal, terminal);\n    weigh(terminal, 1, \"routed\"); setTimeout(() => bump(terminal), 1500);\n    styleEdge(terminal, \"trace\", terminal); pulse(terminal, \"trace\", terminal === \"commit\" ? COLORS.green : COLORS.coral, 1550);\n    weigh(\"trace\", 1, \"routed\"); setTimeout(() => bump(\"trace\"), 2050);\n    state.lastTrace = { kind, operation, seq: envelope.seq, t_ms: envelope.t_ms, legacy: true, trace: null, heldFamilies: [...heldFamilies], codes, counts: null };\n    renderLegend(); renderLastTrace();\n  }\n\n  // Legend rows are generated from the states on screen for the current event\n  // (never authored once and left to drift), reproducing the exact swatch.\n  function swatch(name) {\n    const s = STATE_STYLE[name];\n    const hatched = s.fill === \"url(#hatch-oos)\";\n    const hatchDef = hatched ? `<defs><pattern id=\"hatch-legend\" width=\"6\" height=\"6\" patternTransform=\"rotate(45)\" patternUnits=\"userSpaceOnUse\"><rect width=\"6\" height=\"6\" fill=\"${COLORS.card}\"/><line x1=\"0\" y1=\"0\" x2=\"0\" y2=\"6\" stroke=\"${COLORS.muted}\" stroke-width=\"2\" stroke-opacity=\"0.55\"/></pattern></defs>` : \"\";\n    return `<svg class=\"swatch\" viewBox=\"0 0 22 22\" aria-hidden=\"true\">${hatchDef}${s.ring ? `<circle cx=\"11\" cy=\"11\" r=\"10\" fill=\"none\" stroke=\"${s.stroke}\" stroke-width=\"1.2\" opacity=\"0.9\"/>` : \"\"}<circle cx=\"11\" cy=\"11\" r=\"7\" fill=\"${hatched ? \"url(#hatch-legend)\" : s.fill}\" stroke=\"${s.stroke}\" stroke-width=\"${s.width}\"${s.dash ? ` stroke-dasharray=\"${s.dash}\"` : \"\"}/></svg>`;\n  }\n  function verdictSwatch(name) {\n    const s = VERDICT_STYLE[name];\n    return `<svg class=\"swatch\" viewBox=\"0 0 22 22\" aria-hidden=\"true\">${s.ring ? `<circle cx=\"11\" cy=\"11\" r=\"10\" fill=\"none\" stroke=\"${s.stroke}\" stroke-width=\"1.2\" opacity=\"0.9\"/>` : \"\"}<circle cx=\"11\" cy=\"11\" r=\"7\" fill=\"${s.fill}\" stroke=\"${s.stroke}\" stroke-width=\"${s.width}\"/></svg>`;\n  }\n  function renderLegend() {\n    const rows = $(\"legend-rows\");\n    const counts = $(\"legend-counts\");\n    const t = state.lastTrace;\n    if (!t) {\n      state.legendRows = [];\n      rows.innerHTML = `<li class=\"hint\">legend rows appear per event, generated from the states the engine reported</li>`;\n      counts.textContent = \"no proposal evaluated yet\";\n      return;\n    }\n    const present = [];\n    for (const f of FAMILIES) if (!present.includes(state.familyState[f])) present.push(state.familyState[f]);\n    const order = [\"pass\", \"fail\", \"skipped\", \"out_of_scope\", \"missing\", \"legacy\"];\n    present.sort((a, b) => order.indexOf(a) - order.indexOf(b));\n    const items = present.map((name) => `<li data-state=\"${name}\">${swatch(name)}<span class=\"glyph mono\">${escapeHtml(STATE_STYLE[name].glyph)}</span> <b>${STATE_STYLE[name].word}</b> <span class=\"hint\">${LEGEND_WORD[name]}</span></li>`);\n    const verdict = t.kind === \"commit\" ? \"commit\" : \"hold\";\n    items.push(`<li data-state=\"${VERDICT_STYLE[verdict].word}\">${verdictSwatch(verdict)}<b>${VERDICT_STYLE[verdict].word}</b> <span class=\"hint\">${verdict === \"commit\" ? \"verdict: entry recorded, new snapshot hash\" : \"verdict: entry held, state unchanged\"}</span></li>`);\n    state.legendRows = [...present, VERDICT_STYLE[verdict].word];\n    rows.innerHTML = items.join(\"\");\n    if (t.legacy) counts.textContent = `legacy: schema-only envelope, no per-check counts (${t.kind === \"hold\" ? `${t.heldFamilies.length} held famil${t.heldFamilies.length === 1 ? \"y\" : \"ies\"}` : \"no family evidence\"})`;\n    else counts.textContent = traceSummaryText(t) + (t.counts.missing ? `, ${t.counts.missing} state missing` : \"\");\n  }\n  function renderLastTrace() {\n    const box = $(\"last-trace\");\n    const t = state.lastTrace;\n    if (!t) { box.textContent = \"no proposal evaluated yet\"; return; }\n    const familyLabel = (families) => families.map((f) => NODES[f].label).join(\"/\") || \"?\";\n    const lines = [];\n    const verdict = t.kind === \"commit\" ? \"COMMIT\" : `HELD at ${t.trace ? t.trace.heldAt || \"?\" : t.codes.join(\"+\")}`;\n    lines.push(`last proposal: ${t.operation}  seq ${t.seq}  t_ms ${t.t_ms}  -> ${verdict}`);\n    if (t.legacy) {\n      lines.push(`legacy: schema-only envelope (no trace); no per-check evidence`);\n      if (t.kind === \"hold\") lines.push(`held family: ${t.heldFamilies.join(\", \") || \"?\"}  codes: ${t.codes.join(\", \") || \"?\"}`);\n      lines.push(`not evaluated for ${t.operation}: unknown (no trace)`);\n      box.textContent = lines.join(\"\\n\");\n      stamp.textContent = `engineering demonstration | seq ${t.seq} | t_ms ${t.t_ms} | ${t.operation} -> ${t.kind === \"commit\" ? \"committed\" : \"held\"} | legacy: schema-only`;\n      return;\n    }\n    const tr = t.trace;\n    lines.push(`#  FAMILY          CODE                      OUTCOME`);\n    tr.checks.forEach((c, i) => {\n      lines.push(`${String(i + 1).padEnd(2)} ${familyLabel(c.families).padEnd(15)} ${c.code.padEnd(25)} ${c.outcome === \"pass\" ? \"v passed\" : c.outcome === \"fail\" ? \"x failed\" : \"? state missing\"}`);\n    });\n    // The rule is driven by the engine's explicit short_circuit / held_at, never\n    // inferred from list position. It sits after the last executed check: the\n    // disclosure pair is always evaluated together, so the check that held the\n    // entry is not necessarily the last one that ran.\n    if (tr.shortCircuit) {\n      lines.push(`   == short-circuit here: remaining in-scope checks were not run ==`);\n      const heldIndex = tr.checks.findIndex((c) => c.code === tr.heldAt);\n      if (heldIndex >= 0 && heldIndex < tr.checks.length - 1) lines.push(`   (held at #${heldIndex + 1} ${tr.heldAt}; the disclosure pair is always evaluated together)`);\n    }\n    tr.skipped.forEach((s, i) => {\n      lines.push(`${String(tr.checks.length + i + 1).padEnd(2)} ${familyLabel(s.families).padEnd(15)} ${s.code.padEnd(25)} ->| skipped`);\n    });\n    const oos = FAMILIES.filter((f) => tr.states[f] === \"out_of_scope\");\n    lines.push(\"\");\n    lines.push(`Not evaluated for ${t.operation} (out of scope): ${oos.length ? oos.join(\", \") : \"none\"}`);\n    if (tr.missing.length) lines.push(`! state missing from payload: ${tr.missing.join(\", \")} (rendered \"state missing\", not a pass)`);\n    box.textContent = lines.join(\"\\n\");\n    stamp.textContent = `engineering demonstration | seq ${t.seq} | t_ms ${t.t_ms} | ${t.operation} -> ${t.kind === \"commit\" ? \"committed\" : \"held\"}`;\n  }\n\n  // ------------------------------------------------------------------ metrics\n  function renderGateTable() {\n    const table = $(\"gate-table\");\n    const max = Math.max(1, ...Object.values(state.holdsByGate));\n    const ref = Array.isArray(state.reference?.paper_predicates) ? state.reference.paper_predicates : [];\n    const rows = FAMILIES.map((f) => {\n      const meta = ref.find((r) => r.family === f) || { symbol: \"\", engine_codes: [] };\n      const n = state.holdsByGate[f] || 0;\n      const ev = state.familyEval[f];\n      const codes = meta.engine_codes.map((c) => `${c}${state.codeCounts[c] ? ` x${state.codeCounts[c]}` : \"\"}`).join(\", \") || \"-\";\n      return `<tr><td><span class=\"mono\">${meta.symbol}</span> ${f}</td><td class=\"bar-cell\"><div class=\"bar-fill\" style=\"width:${(100 * n) / max}%\"></div><span class=\"mono\">${n}</span></td><td class=\"num\" title=\"checks the engine evaluated at this family (from traces)\">${ev.evaluated}</td><td class=\"num\">${ev.passed}</td><td class=\"num\">${ev.failed}</td><td class=\"hint\">${codes}</td></tr>`;\n    });\n    table.innerHTML = `<tr><th>predicate family</th><th>holds</th><th>checks evaluated</th><th>passed</th><th>failed</th><th>engine codes seen</th></tr>${rows.join(\"\")}`;\n  }\n  function renderChain() {\n    const ol = $(\"hash-chain\");\n    ol.innerHTML = state.hashChain\n      .slice(-6)\n      .map((h, i, arr) => `<li class=\"${i === arr.length - 1 ? \"head\" : \"\"}\"><span class=\"tag\">${h.tag}</span> ${short(h.hash)} <span class=\"hint\">rev ${h.revision} · stage ${h.stage}</span></li>`)\n      .join(\"\") || `<li class=\"hint\">no snapshot yet</li>`;\n  }\n  function renderReference() {\n    const r = state.reference;\n    const table = $(\"ref-table\");\n    if (!r) { table.innerHTML = `<tr><td class=\"hint\">paper-reference.json not loaded</td></tr>`; return; }\n    if (!r.e1 || !r.e1.repair_arms) { table.innerHTML = `<tr><td class=\"hint\">Legacy paper counts are not present in this semantic reference; live and frozen lanes stay separate.</td></tr>`; return; }\n    const ga = r.e1.repair_arms.guided_repair, ua = r.e1.repair_arms.unchanged_retry;\n    const blindCommits = ua.guided_repairable.commits + ua.oracle_only.commits + ua.irreparable.commits;\n    const blindCases = ua.guided_repairable.cases + ua.oracle_only.cases + ua.irreparable.cases;\n    const rows = [\n      [\"live session · commits / holds\", `${state.counts.commits} / ${state.counts.holds}`, \"engineering demo only\"],\n      [\"live session · reported hold events\", `${state.counts.holds}`, \"engine-reported; immutability checked separately\"],\n      [\"E1 gate fixtures agree\", `${r.e1.gate_fixtures[0]}/${r.e1.gate_fixtures[1]}`, `${r.e1.implemented_codes} encoded codes`],\n      [\"E1 guided repair rho (guided-repairable)\", `${ga.guided_repairable.commits}/${ga.guided_repairable.cases}`, \"C5 · frozen designed fixtures\"],\n      [\"E1 blind unchanged retry\", `${blindCommits}/${blindCases}`, \"matched budget, no error feedback\"],\n      [\"E1 detectable integrity faults rejected\", `${r.e1.integrity_faults[0]}/${r.e1.integrity_faults[1]}`, \"C3 designated check operations\"],\n      [`E2 ${r.e2.cell} (K=${r.e2.K})`, `rho ${r.e2.guided_commits}/${r.e2.initially_invalid} vs blind ${r.e2.blind_commits}/${r.e2.initially_invalid}`, \"screening-pilot-only\"],\n    ];\n    table.innerHTML = `<tr><th>row</th><th>count</th><th>boundary</th></tr>${rows.map(([a, b, c]) => `<tr><td>${a}</td><td class=\"num\">${b}</td><td class=\"hint\">${c}</td></tr>`).join(\"\")}`;\n  }\n  function renderKpis(summary) {\n    if (!summary) return;\n    $(\"kpi-commits\").textContent = summary.commit_count ?? state.counts.commits;\n    $(\"kpi-holds\").textContent = summary.refusal_count ?? state.counts.holds;\n    $(\"kpi-stage\").textContent = summary.stage ?? \"—\";\n    $(\"kpi-revision\").textContent = summary.revision ?? \"0\";\n    $(\"kpi-facts\").textContent = summary.fact_count ?? \"0\";\n    $(\"kpi-episode\").textContent = state.episodeOver ? \"complete\" : \"open\";\n    $(\"session-hash\").textContent = `state ${short(summary.state_sha256)}`;\n    renderQuest(summary);\n  }\n  // ------------------------------------------------------------------ public semantic disclosure lane\n  // Only the additive, public-safe explanation contract is consumed here. Unknown\n  // or malformed values remain unknown; the dashboard never turns absence into pass.\n  const HASH_RE = /^[a-f0-9]{64}$/i;\n  const safeToken = (value, fallback = \"unknown\") => {\n    if (typeof value !== \"string\") return fallback;\n    const token = value.trim().slice(0, 120);\n    return token && /^[A-Za-z0-9_.:/+ -]+$/.test(token) ? token : fallback;\n  };\n  const safeHash = (value) => typeof value === \"string\" && HASH_RE.test(value) ? value.toLowerCase() : null;\n  const EXPLANATION_SCHEMA_ID = \"trace-rpg-semantic-explanation\";\n  const EXPLANATION_SCHEMA_VERSION = \"1.0.0\";\n  const PUBLIC_OPERATION_CODES = new Set([\"reveal_hint\"]);\n  const PUBLIC_ACTOR_ROLES = new Set([\"captain\", \"unknown/restricted\"]);\n  const PUBLIC_SUBJECT_TYPES = new Set([\"lead\", \"unknown/restricted\"]);\n  const PUBLIC_RELATIONS = new Set([\"captain_to_lead_disclosure\", \"unknown/restricted\"]);\n  const PUBLIC_DECISIONS = new Set([\"authorized_fresh\", \"authorized_redisplay\", \"denied\"]);\n  const PUBLIC_STATE_EFFECTS = new Set([\"fresh_disclosure\", \"redisplay_no_mutation\", \"denied_no_mutation\"]);\n  const PUBLIC_CHECK_CODES = new Set([\"FORBIDDEN_DISCLOSURE\", \"STAGE_GATED_DISCLOSURE\", \"UNKNOWN_ACTOR\", \"NPC_DOES_NOT_KNOW_FACT\", \"DISCLOSURE_TEMPLATE_UNAVAILABLE\"]);\n  const PUBLIC_GATE_LABELS = new Set([...FAMILIES, \"DISCLOSURE/QUEST STAGE\"]);\n  const DISCLOSURE_RULE_IDS = new Set([\"DISC-001\", \"DISC-002\", \"DISC-003\", \"DISC-004\", \"DISC-005\", \"DISC-006\", \"DISC-007\"]);\n  const publicEnum = (value, allowed) => typeof value === \"string\" && allowed.has(value) ? value : \"unknown\";\n  const safeRuleId = (value) => DISCLOSURE_RULE_IDS.has(value) ? value : \"unknown\";\n  const boolOrUnknown = (value) => typeof value === \"boolean\" ? value : null;\n  const numberOrUnknown = (value) => Number.isSafeInteger(value) && value >= 0 ? value : null;\n  function normalizeExplanation(payload, envelope) {\n    const raw = payload && typeof payload.explanation === \"object\" && payload.explanation !== null ? payload.explanation : null;\n    if (!raw || raw.schema_id !== EXPLANATION_SCHEMA_ID || raw.schema_version !== EXPLANATION_SCHEMA_VERSION) return null;\n    const input = raw.input && typeof raw.input === \"object\" ? raw.input : {};\n    const ontology = raw.ontology && typeof raw.ontology === \"object\" ? raw.ontology : {};\n    const checks = raw.checks && typeof raw.checks === \"object\" ? raw.checks : {};\n    const decision = raw.decision && typeof raw.decision === \"object\" ? raw.decision : {};\n    const effect = raw.state_effect && typeof raw.state_effect === \"object\" ? raw.state_effect : {};\n    const engine = raw.engine && typeof raw.engine === \"object\" ? raw.engine : {};\n    const mapCheck = (item) => item && typeof item === \"object\" ? { code: publicEnum(item.code, PUBLIC_CHECK_CODES), gate: publicEnum(item.gate, PUBLIC_GATE_LABELS), outcome: item.outcome === \"pass\" || item.outcome === \"fail\" ? item.outcome : \"unknown\" } : { code: \"unknown\", gate: \"unknown\", outcome: \"unknown\" };\n    const evaluated = Array.isArray(checks.evaluated) ? checks.evaluated.map(mapCheck) : null;\n    const skipped = Array.isArray(checks.skipped) ? checks.skipped.map(mapCheck) : null;\n    const outOfScope = Array.isArray(checks.out_of_scope) ? checks.out_of_scope.map((value) => publicEnum(value, PUBLIC_GATE_LABELS)).slice(0, 12) : null;\n    const unreported = Array.isArray(checks.unreported) ? checks.unreported.map(mapCheck) : null;\n    const priorHash = safeHash(effect.prior_state_hash);\n    const nextHash = safeHash(effect.next_state_hash);\n    const hashEquality = priorHash && nextHash ? (priorHash === nextHash ? \"equal\" : \"different\") : \"unknown\";\n    const seq = numberOrUnknown(engine.seq) ?? numberOrUnknown(envelope.seq);\n    const tMs = numberOrUnknown(engine.t_ms) ?? numberOrUnknown(envelope.t_ms);\n    return {\n      schema: `${EXPLANATION_SCHEMA_ID} ${EXPLANATION_SCHEMA_VERSION}`,\n      input: { operation: publicEnum(input.operation, PUBLIC_OPERATION_CODES), actorRole: publicEnum(input.actor_role, PUBLIC_ACTOR_ROLES), subjectType: publicEnum(in