ence, role.rule_ids.join(\", \") || \"No disclosure rule assigned / 연결된 공개 규칙 없음\"); row.appendChild(evidence);\n      const observed = document.createElement(\"td\"); observed.dataset.label = \"Observed event / 관측 이벤트\";\n      observed.dataset.observedRole = id; row.appendChild(observed); body.appendChild(row);\n    }\n    for (const [key, title] of [[\"python7\", \"Seven Python checks / Python 검사 7개\"], [\"godot6\", \"Six Godot families / Godot 표시 계열 6개\"], [\"disclosure7\", \"Seven DISC rules / DISC 선언 규칙 7개\"]]) {\n      const section = document.createElement(\"section\"), heading = document.createElement(\"h3\"), list = document.createElement(\"ul\");\n      heading.textContent = title; section.appendChild(heading);\n      for (const rule of map.rule_sets[key]) {\n        const item = document.createElement(\"li\");\n        item.textContent = `${rule.id}: ${key === \"disclosure7\" ? map.disclosure_rule_meanings[rule.id] : rule.label}`;\n        list.appendChild(item);\n      }\n      section.appendChild(list); sets.appendChild(section);\n    }\n    $(\"ontology-map-source\").textContent = `${map.source_packet.path} · v${map.source_packet.packet_version} · SHA256 ${map.source_packet.sha256}. Expectations, not runtime results / 기대값이며 실행 결과가 아님. Python checks, Godot families and DISC rules are distinct, not one-to-one / 세 집합은 별개이며 일대일 대응이 아님.`;\n    $(\"ontology-map-status\").textContent = \"Declarations loaded · observed column follows latest public disclosure event only / 선언 로드 완료 · 관측 열은 최신 공개 이벤트만 반영\";\n    renderOntologyEvidence();\n  }\n  function loadOntologyMap() {\n    fetch(\"ontology-map.json\").then((response) => {\n      if (!response.ok) throw new Error(\"map unavailable\");\n      return response.json();\n    }).then((map) => {\n      if (!validOntologyMap(map)) throw new Error(\"malformed map\");\n      ontologyMap = map; renderOntologyMap(map);\n    }).catch(() => {\n      ontologyMap = null;\n      clearChildren($(\"ontology-map-rows\")); clearChildren($(\"ontology-map-rules\"));\n      $(\"ontology-map-source\").textContent = \"\";\n      $(\"ontology-map-status\").textContent = \"Ontology map unavailable (missing or malformed); evidence missing/unreported / 온톨로지 맵 확인 불가 (누락 또는 형식 오류) · 근거 누락·미보고\";\n    });\n  }\n'\"'''\ns=s[:pos]+code+s[pos:]\ns=s.replace('renderSemanticExplanation(null);renderDisclosureTimeline();updateLinkState();','renderSemanticExplanation(null);renderDisclosureTimeline();renderOntologyEvidence();updateLinkState();')\ns=s.replace('        renderSemanticExplanation(explanation, true);','        renderSemanticExplanation(explanation, true);\\\\n        renderOntologyEvidence();')\ns=s.replace('  const referenceSource = fetch(', '  loadOntologyMap();\\\\n  const referenceSource = fetch(',1)\np.write_text(s)\nPY\nnode --check game-track/web/dashboard/dashboard.js\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_12","type":"agent_message","text":"The table now declares all eight roles and shows observed fields from the latest normalized disclosure event. It keeps the seven Python checks, six Godot families and seven DISC rules distinct, with a local fallback for missing or malformed map data. JavaScript syntax checking passed; browser and game behavior remain unverified."}}
