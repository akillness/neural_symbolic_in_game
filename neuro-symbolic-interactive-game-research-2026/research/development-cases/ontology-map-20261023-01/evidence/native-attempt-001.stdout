{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc \"sed -n '592,650p' game-track/web/dashboard/dashboard.js; sed -n '952,966p' game-track/web/dashboard/dashboard.js; sed -n '1024,1042p' game-track/web/dashboard/dashboard.js; tail -45 game-track/web/dashboard/dashboard.js; rg -n 'engineering-content|engineering' game-track/web/dashboard/dashboard.css; rg -n 'checks|rule_ids|runtime_ontology' src/nesy_game/disclosure.py\"","aggregated_output":"  // ------------------------------------------------------------------ public semantic disclosure lane\n  // Only the additive, public-safe explanation contract is consumed here. Unknown\n  // or malformed values remain unknown; the dashboard never turns absence into pass.\n  const HASH_RE = /^[a-f0-9]{64}$/i;\n  const safeToken = (value, fallback = \"unknown\") => {\n    if (typeof value !== \"string\") return fallback;\n    const token = value.trim().slice(0, 120);\n    return token && /^[A-Za-z0-9_.:/+ -]+$/.test(token) ? token : fallback;\n  };\n  const safeHash = (value) => typeof value === \"string\" && HASH_RE.test(value) ? value.toLowerCase() : null;\n  const EXPLANATION_SCHEMA_ID = \"trace-rpg-semantic-explanation\";\n  const EXPLANATION_SCHEMA_VERSION = \"1.0.0\";\n  const PUBLIC_OPERATION_CODES = new Set([\"reveal_hint\"]);\n  const PUBLIC_ACTOR_ROLES = new Set([\"captain\", \"unknown/restricted\"]);\n  const PUBLIC_SUBJECT_TYPES = new Set([\"lead\", \"unknown/restricted\"]);\n  const PUBLIC_RELATIONS = new Set([\"captain_to_lead_disclosure\", \"unknown/restricted\"]);\n  const PUBLIC_DECISIONS = new Set([\"authorized_fresh\", \"authorized_redisplay\", \"denied\"]);\n  const PUBLIC_STATE_EFFECTS = new Set([\"fresh_disclosure\", \"redisplay_no_mutation\", \"denied_no_mutation\"]);\n  const PUBLIC_CHECK_CODES = new Set([\"FORBIDDEN_DISCLOSURE\", \"STAGE_GATED_DISCLOSURE\", \"UNKNOWN_ACTOR\", \"NPC_DOES_NOT_KNOW_FACT\", \"DISCLOSURE_TEMPLATE_UNAVAILABLE\"]);\n  const PUBLIC_GATE_LABELS = new Set([...FAMILIES, \"DISCLOSURE/QUEST STAGE\"]);\n  const DISCLOSURE_RULE_IDS = new Set([\"DISC-001\", \"DISC-002\", \"DISC-003\", \"DISC-004\", \"DISC-005\", \"DISC-006\", \"DISC-007\"]);\n  const publicEnum = (value, allowed) => typeof value === \"string\" && allowed.has(value) ? value : \"unknown\";\n  const safeRuleId = (value) => DISCLOSURE_RULE_IDS.has(value) ? value : \"unknown\";\n  const boolOrUnknown = (value) => typeof value === \"boolean\" ? value : null;\n  const numberOrUnknown = (value) => Number.isSafeInteger(value) && value >= 0 ? value : null;\n  function normalizeExplanation(payload, envelope) {\n    const raw = payload && typeof payload.explanation === \"object\" && payload.explanation !== null ? payload.explanation : null;\n    if (!raw || raw.schema_id !== EXPLANATION_SCHEMA_ID || raw.schema_version !== EXPLANATION_SCHEMA_VERSION) return null;\n    const input = raw.input && typeof raw.input === \"object\" ? raw.input : {};\n    const ontology = raw.ontology && typeof raw.ontology === \"object\" ? raw.ontology : {};\n    const checks = raw.checks && typeof raw.checks === \"object\" ? raw.checks : {};\n    const decision = raw.decision && typeof raw.decision === \"object\" ? raw.decision : {};\n    const effect = raw.state_effect && typeof raw.state_effect === \"object\" ? raw.state_effect : {};\n    const engine = raw.engine && typeof raw.engine === \"object\" ? raw.engine : {};\n    const mapCheck = (item) => item && typeof item === \"object\" ? { code: publicEnum(item.code, PUBLIC_CHECK_CODES), gate: publicEnum(item.gate, PUBLIC_GATE_LABELS), outcome: item.outcome === \"pass\" || item.outcome === \"fail\" ? item.outcome : \"unknown\" } : { code: \"unknown\", gate: \"unknown\", outcome: \"unknown\" };\n    const evaluated = Array.isArray(checks.evaluated) ? checks.evaluated.map(mapCheck) : null;\n    const skipped = Array.isArray(checks.skipped) ? checks.skipped.map(mapCheck) : null;\n    const outOfScope = Array.isArray(checks.out_of_scope) ? checks.out_of_scope.map((value) => publicEnum(value, PUBLIC_GATE_LABELS)).slice(0, 12) : null;\n    const unreported = Array.isArray(checks.unreported) ? checks.unreported.map(mapCheck) : null;\n    const priorHash = safeHash(effect.prior_state_hash);\n    const nextHash = safeHash(effect.next_state_hash);\n    const hashEquality = priorHash && nextHash ? (priorHash === nextHash ? \"equal\" : \"different\") : \"unknown\";\n    const seq = numberOrUnknown(engine.seq) ?? numberOrUnknown(envelope.seq);\n    const tMs = numberOrUnknown(engine.t_ms) ?? numberOrUnknown(envelope.t_ms);\n    return {\n      schema: `${EXPLANATION_SCHEMA_ID} ${EXPLANATION_SCHEMA_VERSION}`,\n      input: { operation: publicEnum(input.operation, PUBLIC_OPERATION_CODES), actorRole: publicEnum(input.actor_role, PUBLIC_ACTOR_ROLES), subjectType: publicEnum(input.subject_type, PUBLIC_SUBJECT_TYPES) },\n      ontology: { relation: publicEnum(ontology.relation, PUBLIC_RELATIONS), ruleIds: Array.isArray(ontology.rule_ids) ? ontology.rule_ids.map(safeRuleId).slice(0, 16) : [] },\n      checks: { evaluated, skipped, outOfScope, unreported, consistent: boolOrUnknown(checks.consistent) },\n      decision: { outcome: publicEnum(decision.outcome, PUBLIC_DECISIONS), accepted: boolOrUnknown(decision.accepted), resultCodes: Array.isArray(decision.result_codes) ? decision.result_codes.map((value) => publicEnum(value, PUBLIC_CHECK_CODES)).slice(0, 16) : [] },\n      effect: { kind: publicEnum(effect.kind, PUBLIC_STATE_EFFECTS), mutated: boolOrUnknown(effect.mutated), priorHash, nextHash, hashEquality },\n      engine: { seq, tMs },\n    };\n  }\n  function displayValue(value) { return value === null || value === undefined || value === \"\" ? \"unknown\" : String(value); }\n  function renderSemanticExplanation(explanation, hasEvent = false) {\n    const root = $(\"semantic-explanation\");\n    clearChildren(root);\n    if (!explanation) {\n  }\n  function updateLinkState() {\n    const pill=$(\"link-state\"); if(!state.session){pill.textContent=\"waiting for game session\";pill.className=\"pill waiting\";return;}\n    if(state.lastTickAt===null){pill.textContent=\"session received · waiting for game tick\";pill.className=\"pill waiting\";return;}\n    const age=Math.floor((performance.now()-state.lastTickAt)/1000),fresh=age<=5; pill.textContent=`${fresh?\"live\":\"stale\"} · last game tick ${age}s ago`;pill.className=`pill ${fresh?\"live\":\"waiting\"}`;\n  }\n  function resetSessionPresentation() {\n    state.counts={commits:0,holds:0,proposals:0,dialogues:0}; state.holdsByGate=Object.fromEntries(FAMILIES.map((f)=>[f,0])); state.codeCounts={}; state.nodeWeight={};\n    state.familyEval=Object.fromEntries(FAMILIES.map((f)=>[f,{evaluated:0,passed:0,failed:0}])); state.familyState=Object.fromEntries(FAMILIES.map((f)=>[f,\"idle\"]));\n    state.lastTrace=null;state.legendRows=[];state.legacyEvents=0;state.traceErrors=0;state.pendingOperation=\"\";state.hashChain=[];state.lastSummary=null;state.lastTick=null;state.lastTickAt=null;state.events=[];state.disclosureEvents=[];state.latestExplanation=null;state.trail=[];state.player=null;state.focus=\"\";state.lastHoldGates=[];state.episodeOver=false;\n    state.verdicts=[];state.selectedVerdictId=null;state.verdictSerial=0;state.readoutFrozen=false;state.pinnedVerdict=null;state.metMira=false;state.startedAt=performance.now(); clearChildren($(\"log\"));$(\"log-count\").textContent=\"0 events\";\n    $(\"kpi-commits\").textContent=\"0\";$(\"kpi-holds\").textContent=\"0\";$(\"kpi-stage\").textContent=\"—\";$(\"kpi-revision\").textContent=\"0\";$(\"kpi-facts\").textContent=\"0\";$(\"kpi-episode\").textContent=\"waiting\";\n    resetEdges();FAMILIES.forEach((f)=>setFamilyState(f,\"idle\"));setTerminalState(\"commit\",\"terminal_idle\");setTerminalState(\"hold\",\"terminal_idle\");renderLegend();renderLastTrace();renderGateTable();renderReference();renderChain();renderQuest(null);renderVerdictHistory();renderMinimap();renderTimeline();renderSemanticExplanation(null);renderDisclosureTimeline();updateLinkState();\n  }\n  $(\"freeze-readout\").addEventListener(\"click\",()=>{if(state.readoutFrozen){state.readoutFrozen=false;state.pinnedVerdict=null;const latest=state.verdicts[state.verdicts.length-1];state.selectedVerdictId=latest?latest.id:null;}else{state.readoutFrozen=true;state.pinnedVerdict=state.verdicts.find((item)=>item.id===state.selectedVerdictId)||null;}renderVerdictHistory();});\n        showTraceFlow(\"hold\", payload, msg); addVerdict(\"hold\", payload, msg); flash(\"flash-hold\");\n        renderKpis(payload); renderGateTable(); renderReference();\n        logLine(\"hold\", `${payload.codes.join(\", \")} · gate ${payload.gates.join(\", \")} · state unchanged ${short(payload.state_sha256)} · next: ${payload.next_affordance}${traceLogTag()}`);\n        break;\n      case \"disclosure_outcome\":\n      case \"disclosure_replay\": {\n        const explanation = normalizeExplanation(payload, msg);\n        const event = { kind, seq: explanation?.engine.seq ?? numberOrUnknown(msg.seq), tMs: explanation?.engine.tMs ?? numberOrUnknown(msg.t_ms), explanation, receivedAt: performance.now() };\n        state.disclosureEvents.push(event);\n        if (state.disclosureEvents.length > 180) state.disclosureEvents.shift();\n        state.latestExplanation = explanation;\n        renderSemanticExplanation(explanation, true);\n        renderDisclosureTimeline();\n        record.label = kind;\n        logLine(kind, explanation ? `${explanation.decision.outcome} · ${explanation.effect.kind} · hashes ${explanation.effect.hashEquality}` : \"unknown semantic explanation (malformed or unavailable)\");\n        break;\n      }\n      case \"dialogue\":\n        state.counts.dialogues += 1;\n        // A dialogue choice may run a top-level validate_disclosure (the early-\n        // secret hold) with no proposal envelope; remember it so the strip can\n        // name what the hold was evaluated for.\n        if (payload.phase === \"choice\" && payload.choice_id) state.pendingOperation = String(payload.choice_id);\n        record.label = payload.phase === \"choice\" ? payload.choice_id : payload.phase;\n        logLine(\"dialogue\", `${payload.npc} · ${payload.phase}${payload.choice_id ? ` · ${payload.choice_id}` : \"\"}`);\n        break;\n      case \"focus\":\n        state.focus = payload.interaction_id || \"\";\n        record.label = state.focus || \"\";\n        if (state.focus) logLine(\"focus\", state.focus);\n        renderMinimap();\n        break;\n      case \"episode_complete\":\n        state.episodeOver = true;\n        state.lastSummary = { ...(state.lastSummary || {}), ...payload };\n        renderKpis(state.lastSummary);\n        logLine(\"episode_complete\", `entries ${payload.commit_count} · holds ${payload.refusal_count} · holds by gate ${JSON.stringify(payload.holds_by_gate)} · final ${short(payload.state_sha256)}`);\n        break;\n      default:\n        logLine(kind, JSON.stringify(payload).slice(0, 160));\n    }\n  }\n\n  window.addEventListener(\"message\", (event) => {\n    // Only the embedded game frame on this origin may feed the dashboard; an opener or a\n    // foreign frame posting a well-formed envelope must not be able to paint a fake chain.\n    const game = document.getElementById(\"game\");\n    if (!game || event.source !== game.contentWindow || event.origin !== location.origin) return;\n    const data = event.data;\n    if (!data || data.channel !== CHANNEL) return;\n    try { handle(data); } catch (error) { console.error(\"dashboard handler failed\", error, data); }\n  });\n\n  const referenceSource = fetch(\"disclosure-reference.json\").then((response) => { if (!response.ok) throw new Error(\"semantic reference unavailable\"); return response.json(); }).catch(() => fetch(\"paper-reference.json\").then((response) => { if (!response.ok) throw new Error(\"legacy reference unavailable\"); return response.json(); }));\n  referenceSource.then((ref) => { state.reference = ref; renderGateTable(); renderReference(); renderComparison(); }).catch(() => { renderGateTable(); renderReference(); renderComparison(); });\n  renderChain();\n  renderMinimap();\n  renderTimeline();\n  renderLegend();\n  renderLastTrace();\n  renderSemanticExplanation(null);\n  renderDisclosureTimeline();\n  renderComparison();\n})();\n132:.dashboard { display:grid; grid-template-columns:minmax(0,2fr) minmax(310px,1fr); grid-template-areas:\"game rail\" \"action rail\" \"timeline timeline\" \"engineering engineering\"; gap:14px; width:min(100%,1800px); margin:0 auto; padding:14px 18px 24px; }\n201:.engineering { grid-area:engineering; }\n202:.engineering > summary { display:flex; align-items:center; gap:12px; min-height:42px; color:var(--ink); font-size:15px; font-weight:700; cursor:pointer; }\n203:.engineering > summary .pill { margin-left:auto; }\n204:.engineering-content { display:grid; gap:14px; padding-top:12px; }\n205:.engineering-status { display:flex; align-items:center; gap:10px; color:var(--muted); }\n218:  .dashboard { grid-template-columns:minmax(0,1fr); grid-template-areas:\"game\" \"rail\" \"action\" \"timeline\" \"engineering\"; }\n239:  .engineering > summary { flex-wrap:wrap; }\n240:  .engineering > summary .pill { margin-left:0; }\n241:  .engineering-status { flex-wrap:wrap; }\n48:    runtime_ontology: Mapping[str, Any]\n176:        \"rule_ids\",\n211:def _build_runtime_ontology(\n234:        \"rule_ids\": copy.deepcopy(packet[\"rule_ids\"]),\n294:    ontology = _build_runtime_ontology(packet, scenario)\n301:        runtime_ontology=ontology,\n418:    declaration = contract.runtime_ontology if ontology else None\n420:        scenario_policy = copy.deepcopy(contract.runtime_ontology)\n439:    checks: list[dict[str, str]] = []\n445:            checks.append(_check_result(rule_id, \"fail\"))\n447:        checks.append(_check_result(\"DISC-007\", \"fail\"))\n454:            checks=checks,\n456:            rule_ids=[item[\"rule_id\"] for item in checks],\n465:        checks.append(_check_result(\"DISC-003\", \"fail\"))\n466:        checks.append(_check_result(\"DISC-007\", \"fail\"))\n474:            checks=checks,\n476:            rule_ids=[item[\"rule_id\"] for item in checks],\n481:        checks.append(_check_result(\"DISC-004\", \"fail\"))\n482:        checks.append(_check_result(\"DISC-007\", \"fail\"))\n490:            checks=checks,\n492:            rule_ids=[item[\"rule_id\"] for item in checks],\n497:    checks.append(_check_result(rule_id, \"pass\"))\n505:        checks=checks,\n507:        rule_ids=[rule_id],\n553:        checks=[],\n555:        rule_ids=[],\n569:    checks: list[dict[str, str]],\n571:    rule_ids: list[str],\n582:        \"checks\": checks,\n584:        \"rule_ids\": rule_ids,\n626:            \"ontology_declaration\": copy.deepcopy(contract.runtime_ontology)\n726:            \"checks\",\n728:            \"rule_ids\",\n777:                        \"runtime_ontology\": copy.deepcopy(contract.runtime_ontology),\n782:                    \"rule_ids\": payload[\"rule_ids\"],\n783:                    \"checks\": payload[\"checks\"],\n1092:        \"runtime_ontology\": copy.deepcopy(contract.runtime_ontology),\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_9","type":"agent_message","text":"All eight public input hashes match the contract. The existing disclosure readout already normalizes public event fields; I’ll use those for observed evidence and keep the scenario declarations separate. Unreported fields will stay unavailable."}}
{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport json\nfrom pathlib import Path\nbase=Path('game-track/web/dashboard')\npacket=json.load(open('research/npc-disclosure/reveal-hint-expectations-v1.json'))\nref=json.load(open(base/'disclosure-reference.json'))\nrows=[\n('world','World','세계','sealed-lighthouse-v1; initial_state.world; initial_state.player','Initially harbor_dock and lamp_store are reachable; signal_lens is at lamp_store. These are scenario declarations, not current player position.','초기 도달 가능 장소는 harbor_dock, lamp_store이며 signal_lens는 lamp_store에 있다. 현재 플레이어 위치를 뜻하지 않는다.',['scope.scenario_id','declaration_derivation.stage_axis'],[]),\n('actor','Actor','행위자','captain_mira; initial_state.npcs.captain_mira','captain_mira is the only eligible disclosure actor. Actor eligibility is checked after policy; unknown actors are denied.','공개 적격 행위자는 captain_mira뿐이다. 정책 확인 후 적격성을 확인하며 미등록 행위자는 거부한다.',['scope.eligible_actor_ids','M-001','M-007'],['DISC-003','DISC-007']),\n('knowledge','Knowledge','지식','captain_mira.knowledge → canonical fact IDs','Mira initially knows dock_saved, keeper_betrayal, lighthouse_dark and tide_marks_hint. Knowing a fact does not authorize disclosure; prior disclosed membership also does not bypass authorization.','미라의 초기 지식은 dock_saved, keeper_betrayal, lighthouse_dark, tide_marks_hint이다. 지식이나 과거 공개 이력만으로 공개가 허용되지는 않는다.',['declaration_derivation.knowledge_axis','declaration_derivation.prior_disclosure_axis'],['DISC-004','DISC-006']),\n('fact','Fact','사실','dock_saved; keeper_betrayal; lighthouse_dark; tide_marks_hint','Initial facts are dock_saved and lighthouse_dark. The four canonical IDs are the union of initial facts and Mira knowledge; keeper_betrayal is an identifier only, with no secret payload here.','초기 사실은 dock_saved, lighthouse_dark이다. 네 정규 ID는 초기 사실과 미라 지식의 합집합이며 keeper_betrayal의 비밀 내용은 포함하지 않는다.',['scope.canonical_fact_ids','declaration_derivation.fact_axis'],['DISC-001','DISC-005']),\n('policy','Policy','정책','sealed-lighthouse-disclosure-v1; permanently_forbidden; stage_gates','keeper_betrayal is permanently forbidden. tide_marks_hint requires quest.stage ≥ 2. Policy denial precedes actor/knowledge checks; denial uses mira-safe-deflection-v1 without canonical mutation.','keeper_betrayal은 영구 공개 금지이다. tide_marks_hint에는 quest.stage ≥ 2가 필요하다. 정책 거부는 행위자·지식 확인보다 우선하며 mira-safe-deflection-v1만 표시하고 정규 상태를 보존한다.',['rule_ids','M-007','M-008'],['DISC-001','DISC-002','DISC-007']),\n('quest','Quest','퀘스트','initial_state.quest.stage; quest.flags; tide_marks_hint','Initial stage is 0 with dock_saved flag. The hint gate is stage 2; disclosure preserves stage. B-003/B-004 probe stages 1/2, not observed quest progress.','초기 단계는 0이며 dock_saved 플래그가 있다. 힌트 허용 단계는 2이고 공개 시 단계는 유지된다. B-003/B-004는 단계 1/2의 기대 사례이며 관측 진행도가 아니다.',['declaration_derivation.stage_axis','B-003','B-004'],['DISC-002','DISC-005']),\n('action','Action','행동','reveal_hint(actor_id, fact_id); sl-rc-003-authorized-hint','Fresh authorization adds the requested fact and disclosed ID, preserves stage and increments revision once. Only tide_marks_hint adds turn-05:mira-shared-tide-marks-hint. Authorized redisplay rechecks permission with no mutation; generic allowed facts have no dialogue template.','최초 허용 공개는 요청 사실과 공개 ID를 추가하고 단계를 보존하며 리비전을 한 번 증가시킨다. tide_marks_hint만 turn-05:mira-shared-tide-marks-hint를 추가한다. 재표시는 권한을 재확인하고 상태를 바꾸지 않는다. 일반 허용 사실에는 대화 템플릿이 없다.',['declaration_derivation.first_disclosure_effect','declaration_derivation.redisplay_effect','integration_contract.display_assertions'],['DISC-005','DISC-006','DISC-007']),\n('trace','Trace','추적','prior_state_hash; next_state_hash; rule_ids; template_id; case_id','Frozen expectations contain 48 normal, 4 boundary and 8 malformed cases, plus two rule-change fixtures. They are not live events. Evidence binds packet/version, rules, hashes and template; missing runtime fields cannot establish a pass or full state.','동결 기대값은 정상 48건, 경계 4건, 비정상 8건과 규칙 변경 픽스처 2건이다. 실시간 이벤트가 아니다. 근거에는 패킷·버전, 규칙, 해시, 템플릿이 연결되며 누락 필드는 통과나 전체 상태의 근거가 될 수 없다.',['strata_denominators','integration_contract.evidence'],list(packet['rule_ids']))]\nroles=[]\nfor id,en,ko,ids,content_en,content_ko,evidence,rules in rows:\n roles.append(dict(id=id,labels=dict(en=en,ko=ko),identifiers=ids,content=dict(en=content_en,ko=content_ko),evidence_refs=evidence,rule_ids=rules))\nm=dict(schema_version='ontology-evidence-map/v1',source_packet=dict(path='research/npc-disclosure/reveal-hint-expectations-v1.json',packet_id=packet['packet_id'],packet_version=packet['packet_version'],sha256='9920aa834910a3ee35ed4446de4fdba42bb67dda71b07a93bccfc7a0b2e09028',status=packet['status']),scenario=dict(path='game-track/godot/data/sealed_lighthouse.json',sha256='f262455e57be7204f5f597736a89379f37f3f698475fa745a48be6ef2ebb28d9'),rule_sets=ref['disclosure_rules'],disclosure_rule_meanings=packet['rule_ids'],roles=roles)\n(base/'ontology-map.json').write_text(json.dumps(m,ensure_ascii=False,indent=2)+'\\\\n')\np=base/'index.html';s=p.read_text();needle='      <section class=\\\"nebula card\\\"'\nsection='''      <section class=\\\"ontology-map card\\\" aria-labelledby=\\\"ontology-map-title\\\">\n        <div class=\\\"card-head\\\"><h2 id=\\\"ontology-map-title\\\">Ontology structure → evidence / <span lang=\\\"ko\\\">온톨로지 구조 → 근거</span></h2></div>\n        <p class=\\\"diagram-boundary\\\" id=\\\"ontology-map-boundary\\\">Read-only declarations and latest public disclosure event are separate. Missing/unreported evidence is never pass. Full canonical state is unavailable from this projection. / <span lang=\\\"ko\\\">읽기 전용 선언과 최신 공개 이벤트는 별개이다. 누락·미보고 근거는 통과가 아니다. 전체 정규 상태는 이 투영에서 확인할 수 없다.</span></p>\n        <p id=\\\"ontology-map-status\\\" class=\\\"hint\\\" role=\\\"status\\\" aria-live=\\\"polite\\\">Loading declarations; observed evidence missing/unreported. / <span lang=\\\"ko\\\">선언 로딩 중 · 관측 근거 누락·미보고.</span></p>\n        <p id=\\\"ontology-map-source\\\" class=\\\"hint\\\"></p>\n        <div class=\\\"tbl-wrap\\\"><table class=\\\"tbl ontology-table\\\" aria-describedby=\\\"ontology-map-boundary ontology-map-source\\\">\n          <caption>Declared structure versus observed evidence / <span lang=\\\"ko\\\">선언 구조와 관측 근거</span></caption>\n          <thead><tr><th scope=\\\"col\\\">Role / <span lang=\\\"ko\\\">역할</span></th><th scope=\\\"col\\\">Declared content and relations / <span lang=\\\"ko\\\">선언 내용·관계</span></th><th scope=\\\"col\\\">Frozen source evidence and rules / <span lang=\\\"ko\\\">동결 출처·규칙</span></th><th scope=\\\"col\\\">Latest observed disclosure event / <span lang=\\\"ko\\\">최신 관측 공개 이벤트</span></th></tr></thead>\n          <tbody id=\\\"ontology-map-rows\\\"></tbody>\n        </table></div>\n        <div id=\\\"ontology-map-rules\\\" class=\\\"ontology-rule-sets\\\" aria-label=\\\"Distinct rule sets / 구별되는 규칙 집합\\\"></div>\n      </section>\n'''\nassert needle in s;s=s.replace(needle,section+needle,1);p.write_text(s)\np=base/'dashboard.css';p.write_text(p.read_text()+'''\n/* Read-only ontology declarations remain separate from event projections. */\n.ontology-map { overflow-wrap:anywhere; }\n.ontology-table { table-layout:fixed; }\n.ontology-table caption { text-align:left; padding:8px 6px; color:var(--muted); }\n.ontology-table th, .ontology-table td { padding:8px 6px; }\n.ontology-table th:first-child { width:13%; }\n.ontology-table p { margin:0 0 6px; }\n.ontology-table code { font-size:11px; }\n.ontology-rule-sets { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:12px; }\n.ontology-rule-sets ul { padding-left:18px; font-size:12px; }\n@media (max-width:720px) {\n  .ontology-table, .ontology-table tbody, .ontology-table tr, .ontology-table td, .ontology-table th { display:block; width:100%; }\n  .ontology-table thead { position:absolute; width:1px; height:1px; overflow:hidden; clip-path:inset(50%); }\n  .ontology-table th:first-child { width:100%; color:var(--amber); }\n  .ontology-table tbody tr { margin-bottom:12px; border:1px solid var(--line); }\n  .ontology-table td::before { content:attr(data-label); display:block; color:var(--muted); font-weight:600; margin-bottom:4px; }\n  .ontology-rule-sets { grid-template-columns:minmax(0,1fr); }\n}\n''')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
