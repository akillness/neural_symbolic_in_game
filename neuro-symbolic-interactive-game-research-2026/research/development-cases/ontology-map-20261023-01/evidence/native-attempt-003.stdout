{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/zsh -lc 'cat game-track/web/dashboard/ontology-map.json'","aggregated_output":"{\n  \"schema_version\": \"ontology-evidence-map/v1\",\n  \"source_packet\": {\n    \"path\": \"research/npc-disclosure/reveal-hint-expectations-v1.json\",\n    \"packet_id\": \"sl-npc-disclosure-expectations-v1\",\n    \"packet_version\": \"1.0.0\",\n    \"sha256\": \"9920aa834910a3ee35ed4446de4fdba42bb67dda71b07a93bccfc7a0b2e09028\",\n    \"status\": \"FROZEN_EXPECTATIONS_NOT_RUNTIME_RESULTS\"\n  },\n  \"scenario\": {\n    \"path\": \"game-track/godot/data/sealed_lighthouse.json\",\n    \"sha256\": \"f262455e57be7204f5f597736a89379f37f3f698475fa745a48be6ef2ebb28d9\"\n  },\n  \"rule_sets\": {\n    \"boundary\": \"Python validator checks, Godot display families, and frozen disclosure rules are distinct non-isomorphic label sets.\",\n    \"disclosure7\": [\n      {\n        \"id\": \"DISC-001\",\n        \"label\": \"Permanent prohibition\"\n      },\n      {\n        \"id\": \"DISC-002\",\n        \"label\": \"Stage-gated denial\"\n      },\n      {\n        \"id\": \"DISC-003\",\n        \"label\": \"Eligible actor\"\n      },\n      {\n        \"id\": \"DISC-004\",\n        \"label\": \"Actor knowledge\"\n      },\n      {\n        \"id\": \"DISC-005\",\n        \"label\": \"Fresh authorized disclosure\"\n      },\n      {\n        \"id\": \"DISC-006\",\n        \"label\": \"Authorized redisplay\"\n      },\n      {\n        \"id\": \"DISC-007\",\n        \"label\": \"Denial preserves state\"\n      }\n    ],\n    \"godot6\": [\n      {\n        \"id\": \"POLICY\",\n        \"label\": \"Policy\"\n      },\n      {\n        \"id\": \"PRECONDITION\",\n        \"label\": \"Precondition\"\n      },\n      {\n        \"id\": \"REACHABILITY\",\n        \"label\": \"Reachability\"\n      },\n      {\n        \"id\": \"KNOWLEDGE\",\n        \"label\": \"Knowledge\"\n      },\n      {\n        \"id\": \"DISCLOSURE\",\n        \"label\": \"Disclosure\"\n      },\n      {\n        \"id\": \"QUEST STAGE\",\n        \"label\": \"Quest stage\"\n      }\n    ],\n    \"python7\": [\n      {\n        \"id\": \"action_policy\",\n        \"label\": \"Action policy\"\n      },\n      {\n        \"id\": \"precondition\",\n        \"label\": \"Precondition\"\n      },\n      {\n        \"id\": \"object_reachability\",\n        \"label\": \"Object reachability\"\n      },\n      {\n        \"id\": \"npc_knowledge\",\n        \"label\": \"NPC knowledge\"\n      },\n      {\n        \"id\": \"forbidden_disclosure\",\n        \"label\": \"Forbidden disclosure\"\n      },\n      {\n        \"id\": \"quest_stage\",\n        \"label\": \"Quest stage\"\n      },\n      {\n        \"id\": \"quest_stage_monotonicity\",\n        \"label\": \"Quest-stage monotonicity\"\n      }\n    ]\n  },\n  \"disclosure_rule_meanings\": {\n    \"DISC-001\": \"permanently_forbidden fact is always denied\",\n    \"DISC-002\": \"stage-gated fact is denied below minimum stage\",\n    \"DISC-003\": \"only captain_mira is an eligible actor\",\n    \"DISC-004\": \"eligible actor must know the requested fact\",\n    \"DISC-005\": \"fresh allowed disclosure adds the requested canonical fact and disclosed ID; tide_marks_hint additionally adds the declared relationship-memory entry; stage is preserved\",\n    \"DISC-006\": \"allowed redisplay rechecks current authorization and has no canonical mutation\",\n    \"DISC-007\": \"denial preserves canonical state and emits only the safe fallback template\"\n  },\n  \"roles\": [\n    {\n      \"id\": \"world\",\n      \"labels\": {\n        \"en\": \"World\",\n        \"ko\": \"세계\"\n      },\n      \"identifiers\": \"sealed-lighthouse-v1; initial_state.world; initial_state.player\",\n      \"content\": {\n        \"en\": \"Initially harbor_dock and lamp_store are reachable; signal_lens is at lamp_store. These are scenario declarations, not current player position.\",\n        \"ko\": \"초기 도달 가능 장소는 harbor_dock, lamp_store이며 signal_lens는 lamp_store에 있다. 현재 플레이어 위치를 뜻하지 않는다.\"\n      },\n      \"evidence_refs\": [\n        \"scope.scenario_id\",\n        \"declaration_derivation.stage_axis\"\n      ],\n      \"rule_ids\": []\n    },\n    {\n      \"id\": \"actor\",\n      \"labels\": {\n        \"en\": \"Actor\",\n        \"ko\": \"행위자\"\n      },\n      \"identifiers\": \"captain_mira; initial_state.npcs.captain_mira\",\n      \"content\": {\n        \"en\": \"captain_mira is the only eligible disclosure actor. Actor eligibility is checked after policy; unknown actors are denied.\",\n        \"ko\": \"공개 적격 행위자는 captain_mira뿐이다. 정책 확인 후 적격성을 확인하며 미등록 행위자는 거부한다.\"\n      },\n      \"evidence_refs\": [\n        \"scope.eligible_actor_ids\",\n        \"M-001\",\n        \"M-007\"\n      ],\n      \"rule_ids\": [\n        \"DISC-003\",\n        \"DISC-007\"\n      ]\n    },\n    {\n      \"id\": \"knowledge\",\n      \"labels\": {\n        \"en\": \"Knowledge\",\n        \"ko\": \"지식\"\n      },\n      \"identifiers\": \"captain_mira.knowledge → canonical fact IDs\",\n      \"content\": {\n        \"en\": \"Mira initially knows dock_saved, keeper_betrayal, lighthouse_dark and tide_marks_hint. Knowing a fact does not authorize disclosure; prior disclosed membership also does not bypass authorization.\",\n        \"ko\": \"미라의 초기 지식은 dock_saved, keeper_betrayal, lighthouse_dark, tide_marks_hint이다. 지식이나 과거 공개 이력만으로 공개가 허용되지는 않는다.\"\n      },\n      \"evidence_refs\": [\n        \"declaration_derivation.knowledge_axis\",\n        \"declaration_derivation.prior_disclosure_axis\"\n      ],\n      \"rule_ids\": [\n        \"DISC-004\",\n        \"DISC-006\"\n      ]\n    },\n    {\n      \"id\": \"fact\",\n      \"labels\": {\n        \"en\": \"Fact\",\n        \"ko\": \"사실\"\n      },\n      \"identifiers\": \"dock_saved; keeper_betrayal; lighthouse_dark; tide_marks_hint\",\n      \"content\": {\n        \"en\": \"Initial facts are dock_saved and lighthouse_dark. The four canonical IDs are the union of initial facts and Mira knowledge; keeper_betrayal is an identifier only, with no secret payload here.\",\n        \"ko\": \"초기 사실은 dock_saved, lighthouse_dark이다. 네 정규 ID는 초기 사실과 미라 지식의 합집합이며 keeper_betrayal의 비밀 내용은 포함하지 않는다.\"\n      },\n      \"evidence_refs\": [\n        \"scope.canonical_fact_ids\",\n        \"declaration_derivation.fact_axis\"\n      ],\n      \"rule_ids\": [\n        \"DISC-001\",\n        \"DISC-005\"\n      ]\n    },\n    {\n      \"id\": \"policy\",\n      \"labels\": {\n        \"en\": \"Policy\",\n        \"ko\": \"정책\"\n      },\n      \"identifiers\": \"sealed-lighthouse-disclosure-v1; permanently_forbidden; stage_gates\",\n      \"content\": {\n        \"en\": \"keeper_betrayal is permanently forbidden. tide_marks_hint requires quest.stage ≥ 2. Policy denial precedes actor/knowledge checks; denial uses mira-safe-deflection-v1 without canonical mutation.\",\n        \"ko\": \"keeper_betrayal은 영구 공개 금지이다. tide_marks_hint에는 quest.stage ≥ 2가 필요하다. 정책 거부는 행위자·지식 확인보다 우선하며 mira-safe-deflection-v1만 표시하고 정규 상태를 보존한다.\"\n      },\n      \"evidence_refs\": [\n        \"rule_ids\",\n        \"M-007\",\n        \"M-008\"\n      ],\n      \"rule_ids\": [\n        \"DISC-001\",\n        \"DISC-002\",\n        \"DISC-007\"\n      ]\n    },\n    {\n      \"id\": \"quest\",\n      \"labels\": {\n        \"en\": \"Quest\",\n        \"ko\": \"퀘스트\"\n      },\n      \"identifiers\": \"initial_state.quest.stage; quest.flags; tide_marks_hint\",\n      \"content\": {\n        \"en\": \"Initial stage is 0 with dock_saved flag. The hint gate is stage 2; disclosure preserves stage. B-003/B-004 probe stages 1/2, not observed quest progress.\",\n        \"ko\": \"초기 단계는 0이며 dock_saved 플래그가 있다. 힌트 허용 단계는 2이고 공개 시 단계는 유지된다. B-003/B-004는 단계 1/2의 기대 사례이며 관측 진행도가 아니다.\"\n      },\n      \"evidence_refs\": [\n        \"declaration_derivation.stage_axis\",\n        \"B-003\",\n        \"B-004\"\n      ],\n      \"rule_ids\": [\n        \"DISC-002\",\n        \"DISC-005\"\n      ]\n    },\n    {\n      \"id\": \"action\",\n      \"labels\": {\n        \"en\": \"Action\",\n        \"ko\": \"행동\"\n      },\n      \"identifiers\": \"reveal_hint(actor_id, fact_id); sl-rc-003-authorized-hint\",\n      \"content\": {\n        \"en\": \"Fresh authorization adds the requested fact and disclosed ID, preserves stage and increments revision once. Only tide_marks_hint adds turn-05:mira-shared-tide-marks-hint. Authorized redisplay rechecks permission with no mutation; generic allowed facts have no dialogue template.\",\n        \"ko\": \"최초 허용 공개는 요청 사실과 공개 ID를 추가하고 단계를 보존하며 리비전을 한 번 증가시킨다. tide_marks_hint만 turn-05:mira-shared-tide-marks-hint를 추가한다. 재표시는 권한을 재확인하고 상태를 바꾸지 않는다. 일반 허용 사실에는 대화 템플릿이 없다.\"\n      },\n      \"evidence_refs\": [\n        \"declaration_derivation.first_disclosure_effect\",\n        \"declaration_derivation.redisplay_effect\",\n        \"integration_contract.display_assertions\"\n      ],\n      \"rule_ids\": [\n        \"DISC-005\",\n        \"DISC-006\",\n        \"DISC-007\"\n      ]\n    },\n    {\n      \"id\": \"trace\",\n      \"labels\": {\n        \"en\": \"Trace\",\n        \"ko\": \"추적\"\n      },\n      \"identifiers\": \"prior_state_hash; next_state_hash; rule_ids; template_id; case_id\",\n      \"content\": {\n        \"en\": \"Frozen expectations contain 48 normal, 4 boundary and 8 malformed cases, plus two rule-change fixtures. They are not live events. Evidence binds packet/version, rules, hashes and template; missing runtime fields cannot establish a pass or full state.\",\n        \"ko\": \"동결 기대값은 정상 48건, 경계 4건, 비정상 8건과 규칙 변경 픽스처 2건이다. 실시간 이벤트가 아니다. 근거에는 패킷·버전, 규칙, 해시, 템플릿이 연결되며 누락 필드는 통과나 전체 상태의 근거가 될 수 없다.\"\n      },\n      \"evidence_refs\": [\n        \"strata_denominators\",\n        \"integration_contract.evidence\"\n      ],\n      \"rule_ids\": [\n        \"DISC-001\",\n        \"DISC-002\",\n        \"DISC-003\",\n        \"DISC-004\",\n        \"DISC-005\",\n        \"DISC-006\",\n        \"DISC-007\"\n      ]\n    }\n  ]\n}\n","exit_code":0,"status":"completed"}}
