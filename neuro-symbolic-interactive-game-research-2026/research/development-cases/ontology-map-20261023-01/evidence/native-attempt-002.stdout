{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/zsh -lc \"sed -n '645,800p' game-track/web/dashboard/dashboard.js\"","aggregated_output":"  }\n  // Local read-only map: never writes game state or the frozen comparison reference.\n  const ONTOLOGY_ROLES = [\"world\", \"actor\", \"knowledge\", \"fact\", \"policy\", \"quest\", \"action\", \"trace\"];\n  let ontologyMap = null;\n  const unavailableEvidence = \"unavailable · missing/unreported / 확인 불가 · 누락·미보고\";\n  function validOntologyMap(map) {\n    const text = (value) => typeof value === \"string\" && value.trim().length > 0 && value.length <= 4000;\n    const bilingual = (value) => value && text(value.en) && text(value.ko);\n    const strings = (value) => Array.isArray(value) && value.length <= 32 && value.every(text);\n    const sets = map?.rule_sets;\n    return map?.schema_version === \"ontology-evidence-map/v1\"\n      && map.source_packet?.sha256 === \"9920aa834910a3ee35ed4446de4fdba42bb67dda71b07a93bccfc7a0b2e09028\"\n      && map.source_packet?.packet_id === \"sl-npc-disclosure-expectations-v1\"\n      && map.source_packet?.packet_version === \"1.0.0\" && text(map.source_packet.path)\n      && Array.isArray(map.roles) && map.roles.length === ONTOLOGY_ROLES.length\n      && ONTOLOGY_ROLES.every((id) => map.roles.filter((role) => role?.id === id).length === 1)\n      && map.roles.every((role) => bilingual(role.labels) && bilingual(role.content) && text(role.identifiers)\n        && strings(role.evidence_refs) && role.evidence_refs.length > 0 && strings(role.rule_ids)\n        && role.rule_ids.every((id) => DISCLOSURE_RULE_IDS.has(id)))\n      && [[\"python7\", 7], [\"godot6\", 6], [\"disclosure7\", 7]].every(([key, count]) =>\n        Array.isArray(sets?.[key]) && sets[key].length === count\n        && new Set(sets[key].map((rule) => rule?.id)).size === count\n        && sets[key].every((rule) => text(rule?.id) && text(rule?.label)))\n      && [...DISCLOSURE_RULE_IDS].every((id) => text(map.disclosure_rule_meanings?.[id])\n        && sets.disclosure7.some((rule) => rule.id === id));\n  }\n  function ontologyObserved(id) {\n    const event = state.disclosureEvents[state.disclosureEvents.length - 1];\n    const e = event?.explanation;\n    if (!e) return unavailableEvidence;\n    const value = (v) => v === null || v === undefined || v === \"unknown\" || v === \"\" ? unavailableEvidence : String(v);\n    const rules = e.ontology.ruleIds.length ? e.ontology.ruleIds.map(value).join(\", \") : unavailableEvidence;\n    switch (id) {\n      case \"world\": return `Current world/location / 현재 세계·위치: ${unavailableEvidence}`;\n      case \"actor\": return `Reported actor role / 보고된 행위자 역할: ${value(e.input.actorRole)}. Actor ID / 행위자 ID: ${unavailableEvidence}`;\n      case \"knowledge\": return `Knowledge membership; disclosed set / 지식 포함 여부·공개 집합: ${unavailableEvidence}. Relation / 관계: ${value(e.ontology.relation)}`;\n      case \"fact\": return `Subject type / 대상 유형: ${value(e.input.subjectType)}. Canonical fact ID and full facts / 정규 사실 ID·전체 사실: ${unavailableEvidence}`;\n      case \"policy\": return `Reported rule IDs / 보고된 규칙 ID: ${rules}. Full current policy / 전체 현재 정책: ${unavailableEvidence}`;\n      case \"quest\": return `Current quest stage and flags / 현재 퀘스트 단계·플래그: ${unavailableEvidence}`;\n      case \"action\": return `Operation / 연산: ${value(e.input.operation)} · decision / 결정: ${value(e.decision.outcome)} · state effect / 상태 효과: ${value(e.effect.kind)} · mutated / 변경 여부: ${value(e.effect.mutated)}`;\n      case \"trace\": {\n        const checks = (items) => items === null ? unavailableEvidence : items.length ? items.map((c) => `${value(c.code)} (${value(c.gate)}): ${value(c.outcome)}`).join(\"; \") : \"none reported / 보고 항목 없음\";\n        return `seq: ${value(e.engine.seq)} · t_ms: ${value(e.engine.tMs)} · evaluated / 실행: ${checks(e.checks.evaluated)} · skipped / 건너뜀: ${checks(e.checks.skipped)} · unreported / 미보고: ${checks(e.checks.unreported)} · out of scope / 범위 밖: ${e.checks.outOfScope === null ? unavailableEvidence : e.checks.outOfScope.join(\", \") || \"none reported / 보고 항목 없음\"} · prior hash: ${value(e.effect.priorHash)} · next hash: ${value(e.effect.nextHash)} · template ID / 템플릿 ID: ${unavailableEvidence}`;\n      }\n      default: return unavailableEvidence;\n    }\n  }\n  function renderOntologyEvidence() {\n    const body = $(\"ontology-map-rows\");\n    if (!body || !ontologyMap) return;\n    for (const id of ONTOLOGY_ROLES) {\n      const cell = body.querySelector(`[data-observed-role=\"${id}\"]`);\n      if (cell) cell.textContent = ontologyObserved(id);\n    }\n  }\n  function renderOntologyMap(map) {\n    const body = $(\"ontology-map-rows\"), sets = $(\"ontology-map-rules\");\n    if (!body || !sets) return;\n    clearChildren(body); clearChildren(sets);\n    function paragraph(parent, text, lang) {\n      const node = document.createElement(\"p\"); node.textContent = text;\n      if (lang) node.lang = lang;\n      parent.appendChild(node);\n    }\n    for (const id of ONTOLOGY_ROLES) {\n      const role = map.roles.find((item) => item.id === id), row = document.createElement(\"tr\");\n      const heading = document.createElement(\"th\"); heading.scope = \"row\";\n      paragraph(heading, `${role.labels.en} (${role.id})`, \"en\"); paragraph(heading, role.labels.ko, \"ko\"); row.appendChild(heading);\n      const declared = document.createElement(\"td\"); declared.dataset.label = \"Declared / 선언\";\n      paragraph(declared, role.identifiers); paragraph(declared, role.content.en, \"en\"); paragraph(declared, role.content.ko, \"ko\"); row.appendChild(declared);\n      const evidence = document.createElement(\"td\"); evidence.dataset.label = \"Frozen evidence / 동결 근거\";\n      paragraph(evidence, `${map.source_packet.packet_id} · ${role.evidence_refs.join(\"; \")}`);\n      paragraph(evidence, role.rule_ids.join(\", \") || \"No disclosure rule assigned / 연결된 공개 규칙 없음\"); row.appendChild(evidence);\n      const observed = document.createElement(\"td\"); observed.dataset.label = \"Observed event / 관측 이벤트\";\n      observed.dataset.observedRole = id; row.appendChild(observed); body.appendChild(row);\n    }\n    for (const [key, title] of [[\"python7\", \"Seven Python checks / Python 검사 7개\"], [\"godot6\", \"Six Godot families / Godot 표시 계열 6개\"], [\"disclosure7\", \"Seven DISC rules / DISC 선언 규칙 7개\"]]) {\n      const section = document.createElement(\"section\"), heading = document.createElement(\"h3\"), list = document.createElement(\"ul\");\n      heading.textContent = title; section.appendChild(heading);\n      for (const rule of map.rule_sets[key]) {\n        const item = document.createElement(\"li\");\n        item.textContent = `${rule.id}: ${key === \"disclosure7\" ? map.disclosure_rule_meanings[rule.id] : rule.label}`;\n        list.appendChild(item);\n      }\n      section.appendChild(list); sets.appendChild(section);\n    }\n    $(\"ontology-map-source\").textContent = `${map.source_packet.path} · v${map.source_packet.packet_version} · SHA256 ${map.source_packet.sha256}. Expectations, not runtime results / 기대값이며 실행 결과가 아님. Python checks, Godot families and DISC rules are distinct, not one-to-one / 세 집합은 별개이며 일대일 대응이 아님.`;\n    $(\"ontology-map-status\").textContent = \"Declarations loaded · observed column follows latest public disclosure event only / 선언 로드 완료 · 관측 열은 최신 공개 이벤트만 반영\";\n    renderOntologyEvidence();\n  }\n  function loadOntologyMap() {\n    fetch(\"ontology-map.json\").then((response) => {\n      if (!response.ok) throw new Error(\"map unavailable\");\n      return response.json();\n    }).then((map) => {\n      if (!validOntologyMap(map)) throw new Error(\"malformed map\");\n      ontologyMap = map; renderOntologyMap(map);\n    }).catch(() => {\n      ontologyMap = null;\n      clearChildren($(\"ontology-map-rows\")); clearChildren($(\"ontology-map-rules\"));\n      $(\"ontology-map-source\").textContent = \"\";\n      $(\"ontology-map-status\").textContent = \"Ontology map unavailable (missing or malformed); evidence missing/unreported / 온톨로지 맵 확인 불가 (누락 또는 형식 오류) · 근거 누락·미보고\";\n    });\n  }\n  function displayValue(value) { return value === null || value === undefined || value === \"\" ? \"unknown\" : String(value); }\n  function renderSemanticExplanation(explanation, hasEvent = false) {\n    const root = $(\"semantic-explanation\");\n    clearChildren(root);\n    if (!explanation) {\n      const note = document.createElement(\"p\"); note.className = `empty-note ${hasEvent ? \"unknown\" : \"waiting\"}`; note.textContent = hasEvent ? \"Semantic explanation unknown: malformed or unavailable public-safe payload.\" : \"Waiting for a disclosure outcome or replay from the game.\"; root.appendChild(note); return;\n    }\n    const checkCount = (value) => Array.isArray(value) ? value.length : \"unknown\";\n    const checksKnown = [explanation.checks.evaluated, explanation.checks.skipped, explanation.checks.outOfScope, explanation.checks.unreported].every(Array.isArray) && explanation.checks.consistent === true && explanation.checks.unreported.length === 0;\n    const unreportedCodes = explanation.checks.unreported === null ? \"unknown\" : explanation.checks.unreported.map((check) => check.code).join(\", \") || \"none\";\n    const steps = [\n      [\"Typed input\", `${explanation.input.operation}`, `actor role: ${displayValue(explanation.input.actorRole)} · subject: ${displayValue(explanation.input.subjectType)}`, \"known\"],\n      [\"Ontology relation\", explanation.ontology.relation, explanation.ontology.ruleIds.length ? `rules: ${explanation.ontology.ruleIds.join(\", \")}` : \"rules: unknown\", \"known\"],\n      [\"Actual checks\", `${checkCount(explanation.checks.evaluated)} evaluated · ${checkCount(explanation.checks.skipped)} skipped · ${checkCount(explanation.checks.unreported)} unreported`, `${checkCount(explanation.checks.outOfScope)} out of scope · consistent: ${displayValue(explanation.checks.consistent)} · unreported: ${unreportedCodes}`, checksKnown ? \"known\" : \"unknown\"],\n      [\"Decision\", explanation.decision.outcome, `accepted: ${displayValue(explanation.decision.accepted)} · codes: ${explanation.decision.resultCodes.join(\", \") || \"none reported\"}`, explanation.decision.outcome === \"unknown\" ? \"unknown\" : \"known\"],\n      [\"State transition\", explanation.effect.kind, `mutated: ${displayValue(explanation.effect.mutated)} · hashes: ${explanation.effect.hashEquality}`, explanation.effect.hashEquality === \"unknown\" ? \"unknown\" : \"known\"],\n      [\"Engine record\", `seq ${displayValue(explanation.engine.seq)}`, `t_ms ${displayValue(explanation.engine.tMs)} · ${explanation.schema}`, explanation.engine.seq === null || explanation.engine.tMs === null ? \"unknown\" : \"known\"],\n    ];\n    for (const [heading, value, detail, status] of steps) {\n      const article = document.createElement(\"article\"); article.className = \"semantic-step\"; article.dataset.state = status;\n      const h = document.createElement(\"h3\"); h.textContent = heading;\n      const p = document.createElement(\"p\"); p.textContent = value;\n      const small = document.createElement(\"span\"); small.className = \"semantic-detail\"; small.textContent = detail;\n      article.append(h, p, small); root.appendChild(article);\n    }\n  }\n  function renderDisclosureTimeline() {\n    const svg = $(\"disclosure-timeline\"), list = $(\"disclosure-events\"), clock = $(\"timeline-clock\"), status = $(\"disclosure-live-status\");\n    clearChildren(svg); clearChildren(list);\n    const events = [...state.disclosureEvents].sort((a, b) => (a.seq ?? Number.MAX_SAFE_INTEGER) - (b.seq ?? Number.MAX_SAFE_INTEGER) || (a.tMs ?? Number.MAX_SAFE_INTEGER) - (b.tMs ?? Number.MAX_SAFE_INTEGER));\n    if (!events.length) {\n      status.textContent = \"waiting for disclosure events\"; clock.textContent = \"engine clock: waiting\";\n      const li = document.createElement(\"li\"); li.className = \"empty-note\"; li.textContent = \"Waiting for disclosure_outcome or disclosure_replay events.\"; list.appendChild(li); return;\n    }\n    const knownTimes = events.map((event) => event.tMs).filter((value) => value !== null);\n    const minTime = knownTimes.length ? Math.min(...knownTimes) : null;\n    const maxTime = knownTimes.length ? Math.max(...knownTimes) : null;\n    const completeClock = knownTimes.length === events.length;\n    clock.textContent = minTime === null ? \"engine clock: unknown (t_ms not reported); positions show event order\" : !completeClock ? \"engine clock: incomplete (some t_ms unreported); positions show event order\" : `engine clock: t_ms milliseconds · ${minTime}–${maxTime}`;\n    status.textContent = `${events.length} disclosure signal${events.length === 1 ? \"\" : \"s\"} · ordered by engine seq/t_ms`;\n    const xFor = (event, index) => !completeClock || maxTime === minTime ? 100 + index * (800 / Math.max(1, events.length - 1)) : 100 + ((event.tMs - minTime) / (maxTime - minTime)) * 800;\n    const lanes = [{ label: \"outcome\", y: 48 }, { label: \"state effect\", y: 100 }, { label: \"hash equality\", y: 152 }];\n    lanes.forEach((lane) => { el(\"line\", { x1: 88, y1: lane.y, x2: 990, y2: lane.y, stroke: COLORS.line }, svg); const text = el(\"text\", { x: 8, y: lane.y + 4, \"font-size\": 11, fill: COLORS.muted }, svg); text.textContent = lane.label; });\n    events.forEach((event, index) => {\n      const eventKnown = Boolean(event.explanation && event.explanation.decision.outcome !== \"unknown\" && event.explanation.effect.kind !== \"unknown\");\n      const x = xFor(event, index), outcomeColor = event.explanation?.decision.outcome === \"denied\" ? COLORS.coral : eventKnown ? COLORS.green : COLORS.amber;\n      el(\"line\", { x1: x, y1: 30, x2: x, y2: 166, stroke: outcomeColor, \"stroke-width\": 1, opacity: 0.55 }, svg);\n      el(\"circle\", { cx: x, cy: 48, r: 6, fill: outcomeColor }, svg);\n      const effect = event.explanation?.effect.kind || \"unknown\";\n      el(\"rect\", { x: x - 5, y: 95, width: 10, height: 10, fill: effect === \"unknown\" ? COLORS.amber : COLORS.blue, rx: 2 }, svg);\n      const equality = event.explanation?.effect.hashEquality || \"unknown\";\n      el(\"circle\", { cx: x, cy: 152, r: 6, fill: equality === \"equal\" ? COLORS.green : equality === \"different\" ? COLORS.coral : COLORS.amber }, svg);\n","exit_code":0,"status":"completed"}}
