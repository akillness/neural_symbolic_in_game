{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trace-rpg.example/schemas/codex-live-candidate.schema.json",
  "title": "TRACE-RPG live candidate action proposal (soft, non-authoritative)",
  "description": "Structured candidate emitted by a live proposer. The envelope keeps the same authority declaration as the free-text soft proposal: the model proposes, the deterministic hard validator alone authorizes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "status",
    "claim_boundary",
    "authorization_effect",
    "canonical_state_mutated",
    "hard_validation_required",
    "candidate",
    "assumptions",
    "uncertainties"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "status": {
      "type": "string",
      "const": "candidate"
    },
    "claim_boundary": {
      "type": "string",
      "const": "candidate_soft_proposal_only"
    },
    "authorization_effect": {
      "type": "string",
      "const": "none"
    },
    "canonical_state_mutated": {
      "type": "boolean",
      "const": false
    },
    "hard_validation_required": {
      "type": "boolean",
      "const": true
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id",
        "actor_id",
        "action_type",
        "preconditions",
        "effects",
        "required_objects",
        "used_facts",
        "disclosed_facts",
        "required_quest_stage",
        "quest_stage_effect",
        "narrative_text"
      ],
      "properties": {
        "action_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "actor_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "action_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "preconditions": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "effects": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required_objects": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "used_facts": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "disclosed_facts": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required_quest_stage": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "quest_stage_effect": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 64
        },
        "narrative_text": {
          "type": "string",
          "maxLength": 2000
        }
      }
    },
    "assumptions": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "uncertainties": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    }
  }
}
